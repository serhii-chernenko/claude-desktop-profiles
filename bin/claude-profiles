#!/bin/zsh
#
# claude-profiles: run several Claude accounts side by side on macOS.
#
# Usage: claude-profiles <command> [options]
#
#   new [--name N] [--slug s] [--color '#hex'|--hue DEG|--pick-color] [--desktop|--no-desktop]
#       [--cli|--no-cli] [--data-dir P] [--config-dir P] [--dir PATH]... [--link PROJECT_CWD]...
#       [--link-mode symlink|move|copy] [--mode self|launcher] [--no-build] [--yes] [--plain]
#   list [--plain]                      profiles (slug name color desktop app config_dir data_dir)
#   scan [--plain]                      config dirs, data dirs, projects and existing copies to adopt (read-only)
#   show <slug> [--plain]               profile details (--plain: key<TAB>value lines, then one dir line per folder)
#   build <slug>|--all [--mode self|launcher]   (re)build the desktop app; self mode (the default) is one app per profile
#   launcher <slug>                     rebuild only the launcher (launcher mode)
#   migrate-layout <slug> [--yes] [--plain]   turn a launcher-mode profile into one self-mode app "Claude <Name>"
#                                       in /Applications: the launcher and the hidden copy go away
#   dock <slug> fix [--yes] [--dry-run] [--pin]   keep one Dock pin per profile (the app in self mode, else the launcher):
#                                       drop or repoint pins of the hidden copy or an old launcher; --pin adds it when missing
#   resign <slug>                       re-sign only the outer bundle (and the launcher) with the resolved identity
#   set <slug> sign-identity NAME|--clear   pin the signing identity of one profile
#   recolor <slug> [--color '#hex'|--hue DEG|--pick-color]
#   check <slug>                        post-launch checks
#   link <slug>|main                    send claude:// links to a profile (reverts after LINK_TTL) or back
#   remove <slug> [--delete-data] [--delete-config] [--yes]
#   adopt --slug s --name N --app PATH [--launcher PATH] [--data-dir P] [--config-dir P]
#         [--identity NAME] [--color '#hex'] [--dir PATH]...
#   projects <slug> list [--plain]      session history inside the profile's config dir
#   projects <slug> add [--mode symlink|move|copy] [--no-dir] [--yes] CWD...
#                                       bring Claude Code history for CWD into an existing profile
#   setup [--identity NAME]             run once in Terminal: signing identity + auto-rebuild agent
#   status [--plain]                    CLI install, signing identity, agent, source app, claude:// handler
#   install-cli [--from DIR] [--prefix DIR] [--share-dir DIR] [--bin-dir DIR]
#                                       copy this CLI to ~/.local/share/claude-profiles and link ~/.local/bin
#   legacy-agents [--plain]             other LaunchAgents that watch Claude.app or a profile copy
#   legacy-agents disable LABEL [--yes] unload one of them and rename its plist to .disabled
#   auto [--dry-run]                    what the LaunchAgent runs (keeps each profile's mode)
#   uninstall-agent                     remove the LaunchAgent
#   shell-init zsh|bash                 eval "$(claude-profiles shell-init zsh)"
#   shell-init install [zsh|bash] [--rc FILE]    add the eval line to ~/.zshrc or ~/.bashrc (idempotent block)
#   shell-init uninstall [zsh|bash] [--rc FILE]  remove that block
#   shell-init status [zsh|bash] [--rc FILE] [--plain]   installed 0|1 plus conflicting claude definitions
#   dirs <slug> add|rm PATH | dirs <slug> list
#   version | help
#
# --yes never prompts. --plain prints tab-separated output without colors.
# Exit codes: 0 ok, 1 error, 2 usage. Config: $CLAUDE_PROFILES_HOME (~/.config/claude-profiles).
# Self mode (default): the app is /Applications/Claude <Name>.app, a copy of Claude whose app.asar carries a boot
# file (cdp-boot.js) that selects the profile's data dir. It falls back to launcher mode when the Claude build
# cannot be patched safely. Launcher mode: the copy lives in APPS_DIR (config.env, default /Applications/.claude-profiles)
# and a launcher in /Applications named like the profile starts it with --user-data-dir.
# Test overrides: CLAUDE_PROFILES_AGENTS_DIR (LaunchAgents dir), CLAUDE_PROFILES_APPS_DIR (overrides APPS_DIR),
# CLAUDE_PROFILES_LAUNCHER_DIR (app and launcher dir, default /Applications), CLAUDE_PROFILES_APP_MODE (self or launcher,
# the mode `new` and `build` use), CLAUDE_PROFILES_DOCK_PLIST (a plist file that `dock`, `show`, `check`, `build`,
# `migrate-layout` and `remove` read and write instead of the real Dock; the Dock is not restarted).
#
setopt extended_glob
set -euo pipefail
zmodload -F zsh/stat b:zstat
zmodload zsh/datetime

SELF=${0:A}
ROOT=${SELF:h:h}
LIB=$ROOT/lib
CP_VERSION=unknown
if [[ -r $ROOT/VERSION ]]; then
  CP_VERSION=${$(<$ROOT/VERSION)//[[:space:]]/}
fi

CP_HOME=${CLAUDE_PROFILES_HOME:-$HOME/.config/claude-profiles}
CP_HOME=${CP_HOME%/}
CONFIG_FILE=$CP_HOME/config.env
PROFILES_DIR=$CP_HOME/profiles
RULES_FILE=$CP_HOME/rules.tsv
STATE_DIR=$CP_HOME/state
LOCK_DIR=$STATE_DIR/lock
STAGE_DIR=$STATE_DIR/staging
LINK_STAMP=$STATE_DIR/link-at
LOG_FILE=${CLAUDE_PROFILES_LOG:-$HOME/Library/Logs/claude-profiles.log}
PB=/usr/libexec/PlistBuddy
LSREG=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
KEYCHAIN=$HOME/Library/Keychains/login.keychain-db
AGENTS_DIR=${CLAUDE_PROFILES_AGENTS_DIR:-$HOME/Library/LaunchAgents}
DEFAULT_APPS_DIR=/Applications/.claude-profiles
APPS_DIR=${CLAUDE_PROFILES_APPS_DIR:-$DEFAULT_APPS_DIR}
CONFIG_APPS_DIR=$DEFAULT_APPS_DIR
LAUNCHER_DIR=${CLAUDE_PROFILES_LAUNCHER_DIR:-/Applications}
DEFAULT_SHARE_DIR=$HOME/.local/share/claude-profiles
DEFAULT_BIN_DIR=$HOME/.local/bin
RC_BEGIN='# >>> claude-profiles >>>'
RC_END='# <<< claude-profiles <<<'
MAIN_CONFIG_DIR=$HOME/.claude
MAIN_DATA_DIR="$HOME/Library/Application Support/Claude"
MAIN_LOGS_DIR="$HOME/Library/Logs/Claude"
DEFAULT_IDENTITY="Claude Profiles Signing"
DEFAULT_SOURCE_TEAM_ID=Q6L2SF6YDW
DEFAULT_AGENT_LABEL=io.github.claude-desktop-profiles.rebuild
DEFAULT_PALETTE=('#3a7bd5' '#2ecc71' '#9b59b6' '#e67e22' '#e84393' '#16a085' '#f1c40f' '#c0392b')
PROFILE_KEYS=(PROFILE_NAME PROFILE_COLOR PROFILE_SIGN_IDENTITY PROFILE_DESKTOP PROFILE_CLI PROFILE_MODE PROFILE_APP PROFILE_LAUNCHER PROFILE_BUNDLE_ID PROFILE_DATA_DIR PROFILE_CONFIG_DIR)
QUIT_WAIT_SECONDS=20
LOCK_STALE_MINUTES=30
ASAR_BOOT_FILE=cdp-boot.js
ASAR_BOOT_VERSION=2
ASAR_BLOCK_SIZE=4194304
ASAR_ALGORITHM=SHA256
ASAR_INTEGRITY_KEY=Resources/app.asar
ASAR_FUSE_SENTINEL=dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX
ASAR_FUSE_WIRE_VERSION=1
ASAR_FUSE_COUNT=9

PLAIN=0
YES=0
DRY=0
SIGN_ID=-
SIGN_SOURCE=adhoc
SIGN_BLOCKED=
IS_AUTO=${CLAUDE_PROFILES_AUTO:-0}
PARENT_LOCK=${CLAUDE_PROFILES_LOCKED:-0}
LOCK_HELD=0
CLEANUP_PATHS=()
TS_ARGS=()
LAYOUT_BLOCKED=0
BUILD_MODE=${CLAUDE_PROFILES_APP_MODE:-}
KEEP_MODE=${CLAUDE_PROFILES_KEEP_MODE:-0}
ASAR_REASON=""
TMP=""

C_RESET= C_BOLD= C_DIM= C_RED= C_GREEN= C_YELLOW= C_CYAN=

setup_colors() {
  if (( ! PLAIN )) && [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_CYAN=$'\e[36m'
  else
    C_RESET= C_BOLD= C_DIM= C_RED= C_GREEN= C_YELLOW= C_CYAN=
  fi
}

die() { print -u2 -r -- "ERROR: $*"; exit 1; }
usage_error() { print -u2 -r -- "usage: $*"; print -u2 -r -- "Run: claude-profiles help"; exit 2; }
warn() { print -u2 -r -- "WARN:  $*"; }
say() { print -r -- "$*"; }

status_line() {
  local tag=$1 color=$2
  shift 2
  print -r -- "${color}${(r:5:)tag}${C_RESET} $*"
}
ok() { status_line OK "$C_GREEN" "$@"; }
fail() { status_line FAIL "$C_RED" "$@"; }
warnl() { status_line WARN "$C_YELLOW" "$@"; }
infol() { status_line INFO "$C_CYAN" "$@"; }

usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$SELF"
}

cleanup() {
  local p
  if (( LOCK_HELD || PARENT_LOCK )); then
    for p in "${CLEANUP_PATHS[@]}"; do
      [[ -n $p ]] && rm -rf -- "$p"
    done
  fi
  release_lock
  if [[ -n $TMP && -d $TMP ]]; then
    rm -rf -- "$TMP"
  fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
TMP=$(mktemp -d "${TMPDIR:-/tmp}/claude-profiles.XXXXXX")

ensure_home() {
  if [[ ! -d $CP_HOME ]]; then
    mkdir -p -- "${CP_HOME:h}"
    mkdir -m 700 -- "$CP_HOME"
  fi
}

acquire_lock() {
  ensure_home
  mkdir -p -- "$STATE_DIR"
  find "$LOCK_DIR" -maxdepth 0 -mmin +$LOCK_STALE_MINUTES -exec rm -rf {} + 2>/dev/null || true
  mkdir -- "$LOCK_DIR" 2>/dev/null || return 1
  LOCK_HELD=1
}

release_lock() {
  if (( LOCK_HELD )); then
    rmdir -- "$LOCK_DIR" 2>/dev/null || true
    LOCK_HELD=0
  fi
}

renew_lock() {
  touch -- "$LOCK_DIR" 2>/dev/null || true
}

need_lock() {
  if (( PARENT_LOCK || LOCK_HELD )); then
    return 0
  fi
  acquire_lock || die "Another claude-profiles run is in progress ($LOCK_DIR)."
}

log_line() {
  local line="$(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS) $*"
  if (( DRY )); then
    print -r -- "$line"
  else
    mkdir -p -- "${LOG_FILE:h}"
    print -r -- "$line" >> "$LOG_FILE"
  fi
}

stamp_lines() {
  local line
  while IFS= read -r line; do
    log_line "$line"
  done
}

load_config() {
  SOURCE_APP=/Applications/Claude.app
  SIGN_IDENTITY=$DEFAULT_IDENTITY
  BUNDLE_ID_PREFIX=com.anthropic.claudefordesktop
  AGENT_LABEL=$DEFAULT_AGENT_LABEL
  CLI_RULE_MODE=auto
  LINK_TTL=900
  SOURCE_TEAM_ID=$DEFAULT_SOURCE_TEAM_ID
  APPS_DIR=$DEFAULT_APPS_DIR
  if [[ -r $CONFIG_FILE ]]; then
    source "$CONFIG_FILE"
  fi
  APPS_DIR=${APPS_DIR/#\~/$HOME}
  CONFIG_APPS_DIR=$APPS_DIR
  if [[ -n ${CLAUDE_PROFILES_APPS_DIR:-} ]]; then
    APPS_DIR=$CLAUDE_PROFILES_APPS_DIR
  fi
  APPS_DIR=${APPS_DIR%/}
  LAUNCHER_DIR=${LAUNCHER_DIR%/}
  [[ $APPS_DIR == /* && $APPS_DIR != *[[:cntrl:]]* ]] || die "APPS_DIR in $CONFIG_FILE must be an absolute path without control characters."
  if same_path "$APPS_DIR" "$LAUNCHER_DIR"; then
    die "APPS_DIR ($APPS_DIR) must differ from the launcher folder ($LAUNCHER_DIR): the copy and its launcher would share one path."
  fi
  [[ $LINK_TTL == <-> ]] || LINK_TTL=900
  valid_identity "$SIGN_IDENTITY" || die "SIGN_IDENTITY in $CONFIG_FILE must be - or use only letters, digits, space, dot, underscore and dash."
  [[ -z $SOURCE_TEAM_ID || $SOURCE_TEAM_ID =~ '^[A-Z0-9]{10}$' ]] || die "SOURCE_TEAM_ID in $CONFIG_FILE must be empty or a 10-character Team ID."
  valid_mode_choice "$BUILD_MODE" || die "CLAUDE_PROFILES_APP_MODE must be self or launcher (got \"$BUILD_MODE\")."
  AGENT_PLIST=$AGENTS_DIR/$AGENT_LABEL.plist
}

save_config() {
  ensure_home
  {
    print -r -- "SOURCE_APP=${(qqq)SOURCE_APP}"
    print -r -- "SIGN_IDENTITY=${(qqq)SIGN_IDENTITY}"
    print -r -- "BUNDLE_ID_PREFIX=${(qqq)BUNDLE_ID_PREFIX}"
    print -r -- "AGENT_LABEL=${(qqq)AGENT_LABEL}"
    print -r -- "CLI_RULE_MODE=${(qqq)CLI_RULE_MODE}"
    print -r -- "LINK_TTL=$LINK_TTL"
    print -r -- "SOURCE_TEAM_ID=${(qqq)SOURCE_TEAM_ID}"
    print -r -- "APPS_DIR=${(qqq)CONFIG_APPS_DIR}"
  } > "$CONFIG_FILE.tmp"
  mv -f -- "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

ensure_config() {
  if [[ ! -e $CONFIG_FILE ]]; then
    save_config
  fi
}

can_prompt() {
  (( ! YES )) && [[ -t 0 ]]
}

ask() {
  local prompt=$1 default=${2:-}
  REPLY=""
  print -u2 -n -r -- "$prompt"
  read -r REPLY </dev/tty || REPLY=""
  [[ -n $REPLY ]] || REPLY=$default
}

confirm() {
  if (( YES )); then
    return 0
  fi
  can_prompt || die "Confirmation needed: re-run with --yes."
  ask "$1 [y/N] " n
  [[ $REPLY == [yY]* ]]
}

need_value() {
  (( $# >= 2 )) || usage_error "$1 needs a value"
  [[ $2 != --* ]] || usage_error "$1 needs a value"
}

valid_slug() {
  [[ $1 =~ '^[a-z0-9][a-z0-9-]*$' && $1 != default && $1 != main && $1 != all ]]
}

slugify() {
  local s=${(L)1}
  s=${s//[^a-z0-9]##/-}
  s=${s##-##}
  s=${s%%-##}
  print -r -- "$s"
}

has_control_chars() {
  [[ $1 == *[[:cntrl:]]* ]]
}

reject_control_chars() {
  local label=$1 value
  shift
  for value in "$@"; do
    if has_control_chars "$value"; then
      usage_error "$label must not contain control characters"
    fi
  done
}

valid_name() {
  has_control_chars "$1" && return 1
  [[ -n $1 && $1 != *[/:\"\\$'\t'$'\n']* && $1 == [^[:space:]]* && $1 == *[^[:space:]] ]]
}

valid_identity() {
  [[ $1 == - || $1 =~ '^[A-Za-z0-9 ._-]+$' ]]
}

valid_mode_choice() {
  [[ -z $1 || $1 == (self|launcher) ]]
}

normalize_hex() {
  [[ $1 =~ '^#?[0-9a-fA-F]{6}$' ]] || usage_error "invalid color \"$1\" (expected #rrggbb)"
  print -r -- "#${(L)1#\#}"
}

valid_hue() {
  [[ $1 =~ '^-?[0-9]+(\.[0-9]+)?$' ]] || usage_error "invalid hue \"$1\" (expected degrees, 0-360)"
}

abs_path() {
  local p=${1/#\~/$HOME}
  p=${p:a}
  [[ $p == / ]] || p=${p%/}
  print -r -- "$p"
}

same_path() {
  [[ -n $1 && -n $2 && ${1:a} == ${2:a} ]] || [[ -e $1 && -e $2 && ${1:A} == ${2:A} ]]
}

is_main_config() {
  same_path "$1" "$MAIN_CONFIG_DIR"
}

claude_json_for() {
  if is_main_config "$1"; then
    print -r -- "$HOME/.claude.json"
  else
    print -r -- "$1/.claude.json"
  fi
}

plist_get() {
  [[ -f $1/Contents/Info.plist ]] || return 0
  $PB -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null || true
}

app_version() {
  print -r -- "$(plist_get "$1" CFBundleShortVersionString) ($(plist_get "$1" CFBundleVersion))"
}

src_id() {
  plist_get "$SOURCE_APP" CFBundleIdentifier
}

url_scheme() {
  local s plist=$SOURCE_APP/Contents/Info.plist
  [[ -f $plist ]] && s=$($PB -c "Print :CFBundleURLTypes:0:CFBundleURLSchemes:0" "$plist" 2>/dev/null || true)
  print -r -- "${s:-claude}"
}

re_escape() {
  local s=$1 out="" c i
  for (( i = 1; i <= ${#s}; i++ )); do
    c=${s[i]}
    case $c in
      [.\[\]\\^\$*+?\(\)\{\}\|]) out+="\\$c" ;;
      *) out+=$c ;;
    esac
  done
  print -r -- "$out"
}

app_main_pids() {
  pgrep -f "^$(re_escape "$1")/Contents/MacOS/" 2>/dev/null || true
}

app_all_pids() {
  pgrep -f "^$(re_escape "$1")/Contents/" 2>/dev/null || true
}

is_running() {
  [[ -n $(app_main_pids "$1") ]]
}

ls_pid() {
  local out
  out=$(lsappinfo info -only pid -app "$1" 2>/dev/null || true)
  if [[ $out =~ 'pid"?[[:space:]]*=[[:space:]]*([0-9]+)' ]]; then
    print -r -- "$match[1]"
  else
    print -r -- 0
  fi
}

jxa() {
  local script=$1
  shift
  osascript -l JavaScript "$LIB/$script" "$@"
}

as_string() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  print -r -- "\"$s\""
}

notify() {
  osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title (item 2 of argv)' -e 'end run' "$1" "${2:-Claude Profiles}" >/dev/null 2>&1 || true
}

quit_app() {
  local bundle_id=$1 app=$2 waited
  if ! is_running "$app"; then
    return 0
  fi
  osascript -e 'on run argv' -e 'tell application id (item 1 of argv) to quit' -e 'end run' "$bundle_id" >/dev/null 2>&1 || true
  for waited in {1..$QUIT_WAIT_SECONDS}; do
    is_running "$app" || return 0
    sleep 1
  done
  ! is_running "$app"
}

url_get() {
  jxa urlhandler.js get "$1" 2>/dev/null || print -r -- unknown
}

url_set() {
  if [[ -n ${CLAUDE_PROFILES_NO_URL_SET:-} ]]; then
    warn "CLAUDE_PROFILES_NO_URL_SET is set: not changing the $1:// handler (wanted: $2). Change it later with: claude-profiles link"
    return 0
  fi
  jxa urlhandler.js set "$1" "$2" >/dev/null
}

profile_reset() {
  local k
  for k in $PROFILE_KEYS; do
    typeset -g "$k="
  done
  typeset -ga PROFILE_DIRS
  PROFILE_DIRS=()
  typeset -g SLUG=
}

profile_fill_defaults() {
  : ${PROFILE_NAME:=$SLUG}
  : ${PROFILE_DESKTOP:=1}
  : ${PROFILE_CLI:=1}
  [[ $PROFILE_MODE == self ]] || PROFILE_MODE=launcher
  if is_self_mode; then
    : ${PROFILE_APP:=$LAUNCHER_DIR/Claude $PROFILE_NAME.app}
    PROFILE_LAUNCHER=
  fi
  : ${PROFILE_APP:=$APPS_DIR/Claude $PROFILE_NAME.app}
  if ! is_self_mode && [[ -z $PROFILE_LAUNCHER ]]; then
    if same_path "${PROFILE_APP:h}" "$LAUNCHER_DIR"; then
      PROFILE_LAUNCHER="${PROFILE_APP%.app} Launcher.app"
    else
      PROFILE_LAUNCHER="$LAUNCHER_DIR/${PROFILE_APP:t}"
    fi
  fi
  : ${PROFILE_BUNDLE_ID:=$BUNDLE_ID_PREFIX.$SLUG}
  : ${PROFILE_DATA_DIR:=$HOME/Library/Application Support/Claude-${PROFILE_NAME// /-}}
  : ${PROFILE_CONFIG_DIR:=$HOME/.claude-$SLUG}
}

profile_exists() {
  [[ -f $PROFILES_DIR/$1.env ]]
}

profile_load() {
  valid_slug "$1" || usage_error "invalid profile slug \"$1\""
  profile_exists "$1" || die "No profile \"$1\". See: claude-profiles list"
  profile_reset
  source "$PROFILES_DIR/$1.env"
  SLUG=$1
  profile_fill_defaults
}

profile_save() {
  ensure_home
  mkdir -p -- "$PROFILES_DIR"
  local f=$PROFILES_DIR/$SLUG.env k
  local -a quoted
  quoted=( ${(qqq)PROFILE_DIRS[@]} )
  {
    for k in $PROFILE_KEYS; do
      print -r -- "$k=${(qqq)${(P)k}}"
    done
    print -r -- "PROFILE_DIRS=(${quoted[*]})"
  } > "$f.tmp"
  mv -f -- "$f.tmp" "$f"
}

all_slugs() {
  reply=( "$PROFILES_DIR"/*.env(N:t:r) )
}

profile_field() {
  local SLUG ${PROFILE_KEYS[@]}
  local -a PROFILE_DIRS
  profile_load "$1"
  print -r -- "${(P)2}"
}

launcher_id() {
  print -r -- "$PROFILE_BUNDLE_ID.launcher"
}

is_self_mode() {
  [[ $PROFILE_MODE == self ]]
}

layout_of_profile() {
  if is_self_mode; then
    print -r -- self
  elif same_path "${PROFILE_APP:h}" "$APPS_DIR" && ! same_path "$PROFILE_APP" "$PROFILE_LAUNCHER"; then
    print -r -- hidden
  else
    print -r -- legacy
  fi
}

has_old_launcher_naming() {
  [[ $PROFILE_LAUNCHER == "${PROFILE_APP%.app} Launcher.app" ]]
}

regen_rules() {
  local SLUG ${PROFILE_KEYS[@]} s d l
  local -a PROFILE_DIRS lines reply
  all_slugs
  for s in $reply; do
    profile_load "$s"
    if (( PROFILE_CLI )); then
      for d in $PROFILE_DIRS; do
        lines+=( "${#d}"$'\t'"$d"$'\t'"$s"$'\t'"$PROFILE_CONFIG_DIR" )
      done
    fi
  done
  ensure_home
  {
    for l in ${(On)lines}; do
      print -r -- "${l#*$'\t'}"
    done
  } > "$RULES_FILE.tmp"
  mv -f -- "$RULES_FILE.tmp" "$RULES_FILE"
}

RULE_PREFIX=()
RULE_SLUG=()

load_rules() {
  RULE_PREFIX=()
  RULE_SLUG=()
  local p s c
  if [[ ! -r $RULES_FILE ]]; then
    return 0
  fi
  while IFS=$'\t' read -r p s c; do
    if [[ -n $p && -n $s ]]; then
      RULE_PREFIX+=( "$p" )
      RULE_SLUG+=( "$s" )
    fi
  done < "$RULES_FILE"
}

rule_owner() {
  local cwd=$1 best=- blen=0 i p
  for (( i = 1; i <= ${#RULE_PREFIX}; i++ )); do
    p=${RULE_PREFIX[i]}
    if [[ $cwd == "$p" || $cwd == "$p"/* ]] && (( ${#p} > blen )); then
      best=${RULE_SLUG[i]}
      blen=${#p}
    fi
  done
  print -r -- "$best"
}

source_icns() {
  local f
  f=$(plist_get "$SOURCE_APP" CFBundleIconFile)
  if [[ -n $f ]]; then
    f=$SOURCE_APP/Contents/Resources/${f%.icns}.icns
  else
    local -a found
    found=( "$SOURCE_APP"/Contents/Resources/*.icns(N) )
    f=${found[1]:-}
  fi
  [[ -f $f ]] || return 1
  print -r -- "$f"
}

resolve_color() {
  local icns
  if ! icns=$(source_icns); then
    [[ $1 == '#'* ]] || die "No .icns icon found in $SOURCE_APP; a hue needs the source icon (give the color as #hex instead)."
    PROFILE_COLOR=$1
    return 0
  fi
  PROFILE_COLOR=$(jxa color.js resolve "$1" "$icns") || die "Could not resolve the color \"$1\" from $icns"
}

apply_color_choice() {
  local kind=$1 value=${2:-}
  case $kind in
    hex) resolve_color "$(normalize_hex "$value")" ;;
    hue) valid_hue "$value"; resolve_color "$value" ;;
    pick)
      local picked
      picked=$(jxa color.js pick "${PROFILE_COLOR:-${DEFAULT_PALETTE[1]}}") || die "Color selection cancelled."
      resolve_color "$picked" ;;
    *) die "unknown color choice: $kind" ;;
  esac
}

tint_icns() {
  local src=$1 dst=$2 color=$3 set="$TMP/icon-$RANDOM.iconset"
  local -a largest
  rm -rf -- "$set"
  iconutil -c iconset "$src" -o "$set" || return 1
  largest=( "$set"/*.png(.OL[1]N) )
  (( ${#largest} )) || return 1
  jxa color.js tint "$set" "$color" "${largest[1]}" >/dev/null || return 1
  iconutil -c icns "$set" -o "$dst" || return 1
  rm -rf -- "$set"
}

sanitize_ents() {
  local k
  for k in ${(f)"$($PB -c Print "$1" 2>/dev/null | awk -F' = ' '/^    [^ }]/{sub(/^ +/,"",$1); print $1}')"}; do
    case $k in
      com.apple.developer.*|com.apple.application-identifier|keychain-access-groups|*team-identifier)
        $PB -c "Delete :$k" "$1" ;;
    esac
  done
  $PB -c Print "$1" 2>/dev/null | grep -q '^    [^ }]'
}

identity_present() {
  local name=${1:-$SIGN_IDENTITY}
  [[ $name != - ]] && security find-certificate -c "$name" "$KEYCHAIN" >/dev/null 2>&1
}

probe_identity() {
  local name=${1:-$SIGN_IDENTITY} probe="$TMP/sign-probe"
  if ! identity_present "$name"; then
    print -- -
    return 0
  fi
  cp /usr/bin/true "$probe"
  if codesign --force --sign "$name" --timestamp=none "$probe" </dev/null >/dev/null 2>&1; then
    print -r -- "$name"
  else
    print -- -
  fi
}

probe_sign_id() {
  probe_identity "$SIGN_IDENTITY"
}

first_authority() {
  local output
  local -a lines authorities
  output=$(codesign -dvv "$1" 2>&1 || true)
  lines=( "${(@f)output}" )
  authorities=( "${(@M)lines:#Authority=*}" )
  print -r -- "${${authorities[1]:-}#Authority=}"
}

vendor_authority() {
  [[ $1 == (Developer ID|Apple|Mac Developer|Software Signing|Apple Development|Apple Distribution)* ]]
}

app_signing_identity() {
  local app=$1 exe target authority
  local -a targets
  targets=( "$app"/Contents/Frameworks/*Helper*.app(N) )
  exe=$(plist_get "$app" CFBundleExecutable)
  [[ -n $exe && -f $app/Contents/MacOS/$exe ]] && targets+=( "$app/Contents/MacOS/$exe" )
  for target in $targets; do
    authority=$(first_authority "$target")
    if [[ -n $authority ]]; then
      vendor_authority "$authority" && return 1
      print -r -- "$authority"
      return 0
    fi
  done
  return 1
}

usable_app_identity() {
  local name
  name=$(app_signing_identity "$1") || return 1
  valid_identity "$name" && identity_present "$name" || return 1
  print -r -- "$name"
}

resolve_sign_identity() {
  local name i nested
  local -a names sources
  SIGN_ID=-
  SIGN_SOURCE=adhoc
  SIGN_BLOCKED=
  if [[ -n $PROFILE_SIGN_IDENTITY ]]; then
    names+=( "$PROFILE_SIGN_IDENTITY" )
    sources+=( "profile setting" )
  fi
  if [[ -d $PROFILE_APP ]] && nested=$(app_signing_identity "$PROFILE_APP"); then
    names+=( "$nested" )
    sources+=( "current signature of ${PROFILE_APP:t}" )
  fi
  names+=( "$SIGN_IDENTITY" )
  sources+=( "SIGN_IDENTITY" )
  for (( i = 1; i <= ${#names}; i++ )); do
    name=$names[i]
    [[ $name != - ]] || continue
    valid_identity "$name" || { warn "Ignoring signing identity \"$name\" ($sources[i]): unsupported characters."; continue }
    identity_present "$name" || continue
    if [[ $(probe_identity "$name") == "$name" ]]; then
      SIGN_ID=$name
      SIGN_SOURCE=$sources[i]
      return 0
    fi
    [[ -n $SIGN_BLOCKED ]] || SIGN_BLOCKED=$name
  done
  return 0
}

choose_sign_id() {
  resolve_sign_identity
  if [[ $SIGN_ID != - ]]; then
    say "Signing identity: $SIGN_ID ($SIGN_SOURCE)"
    return 0
  fi
  if [[ -n $SIGN_BLOCKED ]]; then
    die "Identity \"$SIGN_BLOCKED\" is in the keychain but a test signature failed (locked keychain or key access?). Not falling back to ad-hoc signing. Unlock the login keychain or run: claude-profiles setup"
  fi
  [[ ${1:-} != keep ]] || refuse_mixed_signature
  if [[ $SIGN_IDENTITY == - && -z $PROFILE_SIGN_IDENTITY ]]; then
    say "Signing: ad-hoc (SIGN_IDENTITY=-)"
  else
    warn "No usable signing identity (\"${PROFILE_SIGN_IDENTITY:-$SIGN_IDENTITY}\" not found): falling back to ad-hoc signing (Keychain/TCC re-prompts after every rebuild). Run in Terminal: claude-profiles setup"
  fi
}

refuse_mixed_signature() {
  [[ $SIGN_ID == - && -d $PROFILE_APP ]] || return 0
  local nested
  nested=$(app_signing_identity "$PROFILE_APP") || return 0
  die "$PROFILE_APP is signed by \"$nested\" inside, but that identity is not usable (missing from the login keychain or the keychain is locked). Signing the outer bundle ad-hoc would mix signatures, and macOS would ask for Keychain and permissions again. Unlock the login keychain, or run a full rebuild: claude-profiles build $SLUG"
}

ts_args() {
  if [[ $SIGN_ID != - ]]; then
    TS_ARGS=( --timestamp=none )
  else
    TS_ARGS=()
  fi
}

sign_one() {
  local ent="$TMP/ent.plist"
  local -a id_args
  [[ -n ${2:-} ]] && id_args=(--identifier "$2")
  ts_args
  rm -f -- "$ent"
  if codesign -d --entitlements - --xml "$1" > "$ent" 2>/dev/null && [[ -s $ent ]] && sanitize_ents "$ent"; then
    codesign --force --sign "$SIGN_ID" "${TS_ARGS[@]}" "${id_args[@]}" --entitlements "$ent" "$1" 2>/dev/null
  else
    codesign --force --sign "$SIGN_ID" "${TS_ARGS[@]}" "${id_args[@]}" "$1" 2>/dev/null
  fi
}

sign_bundle() {
  local bundle=$1 exe ent="$TMP/bundle-ent.plist"
  exe=$($PB -c "Print :CFBundleExecutable" "$bundle/Contents/Info.plist" 2>/dev/null || true)
  ts_args
  rm -f -- "$ent"
  if [[ -n $exe ]] && codesign -d --entitlements - --xml "$bundle/Contents/MacOS/$exe" > "$ent" 2>/dev/null && [[ -s $ent ]] && sanitize_ents "$ent"; then
    codesign --force --sign "$SIGN_ID" "${TS_ARGS[@]}" --entitlements "$ent" "$bundle" 2>"$TMP/codesign.err" || { cat "$TMP/codesign.err" >&2; return 1; }
  else
    codesign --force --sign "$SIGN_ID" "${TS_ARGS[@]}" "$bundle" 2>"$TMP/codesign.err" || { cat "$TMP/codesign.err" >&2; return 1; }
  fi
}

assert_ours() {
  local path=$1 expected=$2 id
  [[ -e $path ]] || return 0
  id=$(plist_get "$path" CFBundleIdentifier)
  if [[ ${(L)id} != ${(L)expected} && ${(L)id} != ${(L)$(src_id)} ]]; then
    die "$path exists and belongs to another app (bundle id \"$id\", expected \"$expected\"). Refusing to touch it."
  fi
}

source_team_ok() {
  [[ -n $SOURCE_TEAM_ID ]] || return 0
  codesign --verify --strict -R="anchor apple generic and certificate leaf[subject.OU] = \"$SOURCE_TEAM_ID\"" "$SOURCE_APP" >/dev/null 2>&1
}

assert_app_path() {
  [[ $1 == /*.app ]] || die "Not an .app path: $1"
  if same_path "$1" "$SOURCE_APP"; then
    die "Refusing to use the source app $SOURCE_APP as a profile app."
  fi
}

copy_icns_path() {
  local app=$1 icon
  icon=$(plist_get "$app" CFBundleIconFile)
  if [[ -n $icon ]]; then
    print -r -- "$app/Contents/Resources/${icon%.icns}.icns"
  fi
}

sha256_of() {
  local out
  out=$(shasum -a 256 -- "$1") || return 1
  print -r -- "${out%% *}"
}

file_size() {
  /usr/bin/stat -f %z -- "$1"
}

asar_u32() {
  local value
  value=$(od -An -t u4 -j "$2" -N 4 -- "$1" 2>/dev/null) || return 1
  value=${value//[[:space:]]/}
  [[ $value == <-> ]] || return 1
  print -r -- "$value"
}

asar_le32() {
  local n=$1
  printf "$(printf '\\x%02x\\x%02x\\x%02x\\x%02x' $(( n & 255 )) $(( (n >> 8) & 255 )) $(( (n >> 16) & 255 )) $(( (n >> 24) & 255 )))"
}

asar_read_header() {
  local asar=$1 out=$2 first pickle payload len
  ASAR_BASE=0
  ASAR_SIZE=0
  [[ -f $asar ]] || return 1
  first=$(asar_u32 "$asar" 0) && pickle=$(asar_u32 "$asar" 4) && payload=$(asar_u32 "$asar" 8) && len=$(asar_u32 "$asar" 12) || return 1
  (( first == 4 && payload == 4 + (len + 3) / 4 * 4 && pickle == payload + 4 )) || return 1
  head -c $(( 16 + len )) -- "$asar" | tail -c "$len" > "$out"
  [[ $(file_size "$out") == "$len" ]] || return 1
  ASAR_BASE=$(( 8 + pickle ))
  ASAR_SIZE=$(file_size "$asar")
  (( ASAR_SIZE >= ASAR_BASE ))
}

asar_extract() {
  local asar=$1 offset=$2 size=$3 out=$4 position lead block=4096 chunk=$TMP/asar-chunk
  [[ $offset == <-> && $size == <-> ]] || return 1
  position=$(( ASAR_BASE + offset ))
  lead=$(( position % block ))
  dd if="$asar" of="$chunk" bs=$block skip=$(( position / block )) count=$(( (lead + size + block - 1) / block )) 2>/dev/null || return 1
  head -c $(( lead + size )) -- "$chunk" | tail -c "$size" > "$out"
  [[ $(file_size "$out") == "$size" ]]
}

asar_entry() {
  local line
  ASAR_E_OFFSET= ASAR_E_SIZE= ASAR_E_ALG= ASAR_E_BLOCK= ASAR_E_HASH= ASAR_E_BLOCKS= ASAR_E_UNPACKED=
  line=$(jxa asar.js entry "$1" "$2" 2>/dev/null) || return $?
  IFS=$'\t' read -r ASAR_E_OFFSET ASAR_E_SIZE ASAR_E_ALG ASAR_E_BLOCK ASAR_E_HASH ASAR_E_BLOCKS ASAR_E_UNPACKED <<<"$line"
}

asar_entry_ok() {
  local asar=$1 header=$2 entry=$3 out=$4 whole=${5:-}
  asar_entry "$header" "$entry" || return 1
  [[ $ASAR_E_ALG == $ASAR_ALGORITHM && $ASAR_E_BLOCK == $ASAR_BLOCK_SIZE && $ASAR_E_UNPACKED == 0 && $ASAR_E_SIZE == <-> ]] || return 1
  if [[ -z $whole ]]; then
    (( ASAR_E_SIZE <= ASAR_BLOCK_SIZE )) && [[ $ASAR_E_BLOCKS == $ASAR_E_HASH ]] || return 1
  fi
  asar_extract "$asar" "$ASAR_E_OFFSET" "$ASAR_E_SIZE" "$out" || return 1
  [[ $(sha256_of "$out") == $ASAR_E_HASH ]]
}

asar_plist_hash() {
  local plist=$1/Contents/Info.plist dump hash
  local -a keys
  dump=$($PB -c "Print :ElectronAsarIntegrity" "$plist" 2>/dev/null) || return 1
  keys=( ${(f)"$(print -r -- "$dump" | awk '/^    [^ ].* = Dict \{$/ { sub(/^    /, ""); sub(/ = Dict \{$/, ""); print }')"} )
  (( ${#keys} == 1 )) && [[ $keys[1] == $ASAR_INTEGRITY_KEY ]] || return 1
  [[ $($PB -c "Print :ElectronAsarIntegrity:${ASAR_INTEGRITY_KEY}:algorithm" "$plist" 2>/dev/null) == $ASAR_ALGORITHM ]] || return 1
  hash=$($PB -c "Print :ElectronAsarIntegrity:${ASAR_INTEGRITY_KEY}:hash" "$plist" 2>/dev/null) || return 1
  [[ $hash =~ '^[0-9a-f]{64}$' ]] || return 1
  print -r -- "$hash"
}

asar_fuse_wire() {
  local framework="$1/Contents/Frameworks/Electron Framework.framework/Electron Framework" start version count wire
  local -a hits
  [[ -f $framework ]] || return 1
  hits=( ${(f)"$(LC_ALL=C grep -a -b -o -F -- "$ASAR_FUSE_SENTINEL" "$framework" 2>/dev/null || true)"} )
  (( ${#hits} == 1 )) || return 1
  start=$(( ${hits[1]%%:*} + ${#ASAR_FUSE_SENTINEL} ))
  version=$(od -An -t u1 -j "$start" -N 1 -- "$framework" 2>/dev/null) || return 1
  count=$(od -An -t u1 -j $(( start + 1 )) -N 1 -- "$framework" 2>/dev/null) || return 1
  version=${version//[[:space:]]/}
  count=${count//[[:space:]]/}
  [[ $version == <-> && $count == <-> ]] || return 1
  wire=$(dd if="$framework" bs=1 skip=$(( start + 2 )) count="$count" 2>/dev/null) || return 1
  print -r -- "$version:$count:$wire"
}

asar_validate() {
  local app=$1 work=$TMP/asar-validate plist_hash wire rc=0
  local asar=$app/Contents/Resources/app.asar
  ASAR_REASON=
  ASAR_MAIN=
  rm -rf -- "$work"
  mkdir -p -- "$work"
  if ! plist_hash=$(asar_plist_hash "$app"); then
    ASAR_REASON="Info.plist has no single SHA256 ElectronAsarIntegrity entry for $ASAR_INTEGRITY_KEY"
    return 1
  fi
  if ! asar_read_header "$asar" "$work/header.json"; then
    ASAR_REASON="unknown app.asar header format"
    return 1
  fi
  if [[ $(sha256_of "$work/header.json") != $plist_hash ]]; then
    ASAR_REASON="the app.asar header hash does not match ElectronAsarIntegrity in Info.plist"
    return 1
  fi
  if ! asar_entry_ok "$asar" "$work/header.json" package.json "$work/package.json"; then
    ASAR_REASON="unknown integrity format (or hash mismatch) for package.json in app.asar"
    return 1
  fi
  if ! ASAR_MAIN=$(jxa asar.js package "$work/package.json" "$work/package.new.json" "$ASAR_BOOT_FILE" 2>/dev/null) || [[ -z $ASAR_MAIN ]]; then
    ASAR_REASON="package.json in app.asar has no usable main entry (missing, already patched, or an ES module)"
    return 1
  fi
  if ! asar_entry_ok "$asar" "$work/header.json" "$ASAR_MAIN" "$work/main.js" whole; then
    ASAR_REASON="the main script $ASAR_MAIN is not a packed file with a matching $ASAR_ALGORITHM hash and a $ASAR_BLOCK_SIZE byte block size in app.asar"
    return 1
  fi
  asar_entry "$work/header.json" "$ASAR_BOOT_FILE" || rc=$?
  if (( rc != 3 )); then
    ASAR_REASON="app.asar already has a $ASAR_BOOT_FILE entry"
    return 1
  fi
  if ! wire=$(asar_fuse_wire "$app"); then
    ASAR_REASON="the Electron fuse wire was not found exactly once"
    return 1
  fi
  if [[ $wire != "$ASAR_FUSE_WIRE_VERSION:$ASAR_FUSE_COUNT:"* || ${wire#*:*:} != [01r](#c$ASAR_FUSE_COUNT) ]]; then
    ASAR_REASON="unknown Electron fuses (version:count:wire $wire, expected $ASAR_FUSE_WIRE_VERSION:$ASAR_FUSE_COUNT)"
    return 1
  fi
  return 0
}

asar_verify_patched() {
  local asar=$1 boot=$2 package=$3 main=$4 work=$TMP/asar-verify
  rm -rf -- "$work"
  mkdir -p -- "$work"
  asar_read_header "$asar" "$work/header.json" || return 1
  ASAR_NEW_HASH=$(sha256_of "$work/header.json") || return 1
  asar_entry_ok "$asar" "$work/header.json" "$ASAR_BOOT_FILE" "$work/boot.js" && cmp -s -- "$work/boot.js" "$boot" || return 1
  asar_entry_ok "$asar" "$work/header.json" package.json "$work/package.json" && cmp -s -- "$work/package.json" "$package" || return 1
  [[ $(jxa asar.js main "$work/package.json" 2>/dev/null) == $ASAR_BOOT_FILE ]] || return 1
  asar_entry_ok "$asar" "$work/header.json" "$main" "$work/main.js" whole
}

patch_asar() {
  local app=$1 work=$TMP/asar-patch original cfg scheme data_size boot_size boot_hash package_size package_hash
  local new_len payload pickle pad asar=$1/Contents/Resources/app.asar plist=$1/Contents/Info.plist
  rm -rf -- "$work" || return 1
  mkdir -p -- "$work" || return 1
  asar_read_header "$asar" "$work/header.json" || { warn "Could not read the app.asar header of the staged copy."; return 1; }
  asar_entry_ok "$asar" "$work/header.json" package.json "$work/package.json" || { warn "package.json in the staged app.asar failed its integrity check."; return 1; }
  original=$(jxa asar.js package "$work/package.json" "$work/package.new.json" "$ASAR_BOOT_FILE") || { warn "Could not rewrite package.json."; return 1; }
  cfg=$(boot_config_dir) || return 1
  scheme=$(url_scheme) || return 1
  jxa asar.js boot "$work/boot.js" "$ASAR_BOOT_VERSION" "$PROFILE_DATA_DIR" "${cfg:--}" "$original" "${(L)scheme}" >/dev/null || { warn "Could not write the boot file."; return 1; }
  boot_size=$(file_size "$work/boot.js") || return 1
  package_size=$(file_size "$work/package.new.json") || return 1
  boot_hash=$(sha256_of "$work/boot.js") || return 1
  package_hash=$(sha256_of "$work/package.new.json") || return 1
  data_size=$(( ASAR_SIZE - ASAR_BASE ))
  jxa asar.js add "$work/header.json" "$work/header.new.json" "$data_size" "$ASAR_BOOT_FILE" "$boot_size" "$boot_hash" package.json "$package_size" "$package_hash" >/dev/null || { warn "Could not extend the app.asar header."; return 1; }
  new_len=$(file_size "$work/header.new.json") || return 1
  payload=$(( 4 + (new_len + 3) / 4 * 4 ))
  pickle=$(( payload + 4 ))
  pad=$(( payload - 4 - new_len ))
  {
    asar_le32 4 || return 1
    asar_le32 "$pickle" || return 1
    asar_le32 "$payload" || return 1
    asar_le32 "$new_len" || return 1
    cat -- "$work/header.new.json" || return 1
    if (( pad > 0 )); then
      head -c "$pad" /dev/zero || return 1
    fi
    dd if="$asar" ibs="$ASAR_BASE" skip=1 obs=1048576 2>/dev/null || return 1
    cat -- "$work/boot.js" "$work/package.new.json" || return 1
  } > "$work/app.asar" || { warn "Could not assemble the patched app.asar."; return 1; }
  if ! asar_verify_patched "$work/app.asar" "$work/boot.js" "$work/package.new.json" "$original"; then
    warn "The patched app.asar failed verification; the staged copy was not changed."
    return 1
  fi
  mv -f -- "$work/app.asar" "$asar" || return 1
  $PB -c "Set :ElectronAsarIntegrity:${ASAR_INTEGRITY_KEY}:hash $ASAR_NEW_HASH" "$plist" || return 1
  [[ $(asar_plist_hash "$app") == $ASAR_NEW_HASH ]]
}

boot_config_dir() {
  is_main_config "$PROFILE_CONFIG_DIR" || print -r -- "$PROFILE_CONFIG_DIR"
}

asar_boot_state() {
  local app=$1 work=$TMP/asar-state plist_hash info boot_main
  BOOT_PRESENT=0 BOOT_VERSION=0 BOOT_DATA= BOOT_CONFIG= BOOT_HASH_OK=0 BOOT_ENTRY_OK=0 BOOT_MAIN_OK=0
  rm -rf -- "$work"
  mkdir -p -- "$work"
  asar_read_header "$app/Contents/Resources/app.asar" "$work/header.json" || return 1
  plist_hash=$(asar_plist_hash "$app" || true)
  if [[ -n $plist_hash && $(sha256_of "$work/header.json") == $plist_hash ]]; then
    BOOT_HASH_OK=1
  fi
  asar_entry "$work/header.json" "$ASAR_BOOT_FILE" || return 0
  BOOT_PRESENT=1
  asar_entry_ok "$app/Contents/Resources/app.asar" "$work/header.json" "$ASAR_BOOT_FILE" "$work/boot.js" && BOOT_ENTRY_OK=1
  [[ -s $work/boot.js ]] || return 0
  if info=$(jxa asar.js boot-info "$work/boot.js" 2>/dev/null); then
    IFS=$'\t' read -r BOOT_VERSION BOOT_DATA BOOT_CONFIG boot_main <<<"$info"
    [[ $BOOT_VERSION == <-> ]] || BOOT_VERSION=0
    [[ $BOOT_CONFIG != - ]] || BOOT_CONFIG=
    [[ $BOOT_DATA != - ]] || BOOT_DATA=
  fi
  if asar_entry_ok "$app/Contents/Resources/app.asar" "$work/header.json" package.json "$work/package.json" \
    && [[ $(jxa asar.js main "$work/package.json" 2>/dev/null) == $ASAR_BOOT_FILE ]]; then
    BOOT_MAIN_OK=1
  fi
  return 0
}

sign_launcher() {
  ts_args
  codesign --force --sign "$SIGN_ID" "${TS_ARGS[@]}" "$1" 2>"$TMP/codesign.err" || { cat "$TMP/codesign.err" >&2; return 1; }
}

build_launcher() {
  local icns=${1:-} L=$PROFILE_LAUNCHER LID stage
  LID=$(launcher_id)
  assert_app_path "$L"
  if same_path "$L" "$PROFILE_APP"; then
    die "The launcher path $L is the app copy itself; building the launcher there would delete the copy. Move the copy: claude-profiles migrate-layout $SLUG"
  fi
  assert_ours "$L" "$LID"
  stage=$TMP/launcher-stage/${L:t}
  stage_launcher "$icns" "$stage" || die "Could not build the launcher for $SLUG."
  install_launcher "$stage" || die "Could not move the new launcher into place at $L."
  rm -rf -- "$L.old"
}

install_launcher() {
  local stage=$1 L=$PROFILE_LAUNCHER
  rm -rf -- "$L.old" || return 1
  mkdir -p -- "${L:h}" || return 1
  if [[ -e $L ]]; then
    "$LSREG" -u "$L" >/dev/null 2>&1 || true
    mv -- "$L" "$L.old" || return 1
  fi
  if ! mv -- "$stage" "$L"; then
    if [[ -e $L.old ]]; then
      mv -- "$L.old" "$L"
    fi
    return 1
  fi
  touch -- "$L"
  "$LSREG" -f "$L" >/dev/null 2>&1 || true
}

stage_launcher() {
  local icns=${1:-} L=$2 LID
  LID=$(launcher_id)
  say "Building launcher..."
  mkdir -p -- "${L:h}" || return 1
  local script=$TMP/launcher.applescript bid open_tail
  bid=$(as_string "$PROFILE_BUNDLE_ID")
  if is_main_config "$PROFILE_CONFIG_DIR"; then
    open_tail="\"open -n -b \" & quoted form of $bid & \" --args \" & quoted form of $(as_string "--user-data-dir=$PROFILE_DATA_DIR")"
  else
    open_tail="\"open -n -b \" & quoted form of $bid & \" --env \" & quoted form of $(as_string "CLAUDE_CONFIG_DIR=$PROFILE_CONFIG_DIR") & \" --args \" & quoted form of $(as_string "--user-data-dir=$PROFILE_DATA_DIR")"
  fi
  local restore_vars restore_logic restore_as
  restore_vars="stamp=${(qq)LINK_STAMP}; slug=${(qq)SLUG}; ttl=${(qq)LINK_TTL}; bid=${(qq)PROFILE_BUNDLE_ID}; src=${(qq)$(src_id)}; scheme=${(qq)$(url_scheme)}; "
  restore_logic='sleep 10; if [ -r "$stamp" ]; then read -r s_slug s_at < "$stamp"; case "$s_at" in ""|*[!0-9]*) s_at=0;; esac; if [ "$s_slug" = "$slug" ] && [ $(( $(date +%s) - s_at )) -le "$ttl" ]; then exit 0; fi; fi; cur=$(/usr/bin/osascript -l JavaScript "$js" get "$scheme" | tr "[:upper:]" "[:lower:]"); [ "$cur" = "$(printf %s "$bid" | tr "[:upper:]" "[:lower:]")" ] || exit 0; /usr/bin/osascript -l JavaScript "$js" set "$scheme" "$src"'
  restore_as=$(as_string "$restore_vars$restore_logic")
  cat > "$script" <<EOF
if application id $bid is running then
  tell application id $bid
    reopen
    activate
  end tell
else
  do shell script $open_tail
  set handlerScript to POSIX path of (path to resource "urlhandler.js")
  do shell script "(js=" & quoted form of handlerScript & "; " & $restore_as & ") >/dev/null 2>&1 &"
end if
EOF
  rm -rf -- "$L"
  osacompile -o "$L" "$script" >"$TMP/osacompile.log" 2>&1 || { cat "$TMP/osacompile.log" >&2; warn "osacompile failed for the launcher of $SLUG."; return 1; }
  cp -- "$LIB/urlhandler.js" "$L/Contents/Resources/urlhandler.js" || return 1
  local LPLIST="$L/Contents/Info.plist"
  plutil -replace CFBundleIdentifier -string "$LID" "$LPLIST" || return 1
  plutil -remove CFBundleIconName "$LPLIST" 2>/dev/null || true
  rm -f -- "$L/Contents/Resources/Assets.car"
  if [[ -f $icns ]]; then
    cp -- "$icns" "$L/Contents/Resources/applet.icns" || return 1
  fi
  xattr -cr "$L"
  sign_launcher "$L" || { warn "Could not sign the launcher for $SLUG."; return 1; }
}

dock_read() {
  local dest=$1
  if [[ -n ${CLAUDE_PROFILES_DOCK_PLIST:-} ]]; then
    [[ -r $CLAUDE_PROFILES_DOCK_PLIST ]] || return 1
    cp -- "$CLAUDE_PROFILES_DOCK_PLIST" "$dest"
  else
    defaults export com.apple.dock - > "$dest" 2>/dev/null
  fi
  plutil -lint "$dest" >/dev/null 2>&1
}

dock_restart() {
  [[ -n ${CLAUDE_PROFILES_DOCK_PLIST:-} ]] || killall Dock 2>/dev/null || true
}

dock_write() {
  local src=$1
  if [[ -n ${CLAUDE_PROFILES_DOCK_PLIST:-} ]]; then
    cp -- "$src" "$CLAUDE_PROFILES_DOCK_PLIST"
    return
  fi
  defaults import com.apple.dock "$src" || return 1
  dock_restart
}

dock_backup_dir() {
  if [[ -n ${CLAUDE_PROFILES_HOME:-} ]]; then
    print -r -- "$CP_HOME/backups"
  else
    print -r -- "$HOME/Library/Application Support/claude-profiles"
  fi
}

dock_backup() {
  local source_file=$1 dir stamp target n=1
  dir=$(dock_backup_dir)
  mkdir -p -- "$dir"
  stamp=$(strftime '%Y%m%d-%H%M%S' $EPOCHSECONDS)
  target=$dir/dock-backup-$stamp.plist
  while [[ -e $target ]]; do
    n=$(( n + 1 ))
    target=$dir/dock-backup-$stamp-$n.plist
  done
  cp -- "$source_file" "$target"
  print -r -- "$target"
}

dock_url_path() {
  local u=$1 d
  [[ $u == file://* ]] || return 0
  u=${u#file://}
  u=${u#localhost}
  d=${u//\%/\\x}
  d=$(printf '%b' "$d")
  print -r -- "${d%/}"
}

dock_encode_path() {
  local hex byte char out=""
  hex=$(print -rn -- "$1" | od -An -v -tx1)
  for byte in ${=hex}; do
    char=""
    if (( 16#$byte < 128 )); then
      char=$(printf "\\x$byte")
    fi
    if [[ -n $char && $char == [A-Za-z0-9/._~-] ]]; then
      out+=$char
    else
      out+="%${(U)byte}"
    fi
  done
  print -r -- "$out"
}

dock_tile_xml() {
  local app=$1 label=$2 url
  url="file://$(dock_encode_path "$app")/"
  print -r -- "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>$url</string><key>_CFURLStringType</key><integer>15</integer></dict><key>file-label</key><string>$(xml_escape "$label")</string></dict><key>tile-type</key><string>file-tile</string></dict>"
}

dock_same_path() {
  [[ ${(L)1%/} == ${(L)2%/} ]]
}

dock_profile_args() {
  local candidate
  local -a candidates
  DOCK_OLDS=()
  if is_self_mode; then
    DOCK_COPY=
    DOCK_LAUNCHER=$PROFILE_APP
    DOCK_LID=$PROFILE_BUNDLE_ID
    DOCK_LABEL=${PROFILE_APP:t:r}
    candidates=( "$APPS_DIR/${PROFILE_APP:t}" )
  else
    DOCK_COPY=$PROFILE_APP
    DOCK_LAUNCHER=$PROFILE_LAUNCHER
    DOCK_LID=$(launcher_id)
    DOCK_LABEL=${PROFILE_LAUNCHER:t:r}
  fi
  candidates+=( "$LAUNCHER_DIR/${PROFILE_APP:t:r} Launcher.app" "${PROFILE_APP%.app} Launcher.app" "$@" )
  for candidate in $candidates; do
    [[ -n $candidate ]] || continue
    dock_same_path "$candidate" "$DOCK_LAUNCHER" && continue
    dock_same_path "$candidate" "$PROFILE_APP" && continue
    (( ${DOCK_OLDS[(Ie)$candidate]} )) || DOCK_OLDS+=( "$candidate" )
  done
}

dock_analyze() {
  local work=$1 idx url bid pinned old
  DA_COPY=() DA_OLD=() DA_LAUNCHER=() DA_STALE=()
  while IFS=$'\t' read -r idx url bid; do
    [[ -n $idx && $url != - ]] || continue
    pinned=$(dock_url_path "$url")
    [[ -n $pinned ]] || continue
    if [[ -n $DOCK_COPY ]] && dock_same_path "$pinned" "$DOCK_COPY"; then
      DA_COPY+=( $idx )
    elif dock_same_path "$pinned" "$DOCK_LAUNCHER"; then
      DA_LAUNCHER+=( $idx )
      if [[ $bid != - && ${(L)bid} != ${(L)DOCK_LID} ]]; then
        DA_STALE+=( $idx )
      fi
    else
      for old in $DOCK_OLDS; do
        if dock_same_path "$pinned" "$old"; then
          DA_OLD+=( $idx )
          break
        fi
      done
    fi
  done < <(plutil -p "$work" | awk '
    function flush() { if (idx != "") print idx "\t" (url == "" ? "-" : url) "\t" (bid == "" ? "-" : bid); idx = ""; url = ""; bid = "" }
    /^  "persistent-apps" => \[/ { inapps = 1; next }
    inapps && /^  \]/ { flush(); inapps = 0; next }
    inapps && /^    [0-9]+ => \{/ { flush(); idx = $1; next }
    inapps && /"_CFURLString" =>/ { s = $0; sub(/^.*"_CFURLString" => "/, "", s); sub(/"$/, "", s); url = s }
    inapps && /"bundle-identifier" =>/ { s = $0; sub(/^.*"bundle-identifier" => "/, "", s); sub(/"$/, "", s); bid = s }
    END { flush() }')
}

dock_state() {
  if is_self_mode; then
    if (( ${#DA_STALE} || ${#DA_OLD} )); then
      print -r -- old_launcher_pinned
    elif (( ! ${#DA_LAUNCHER} )); then
      print -r -- not_pinned
    else
      print -r -- ok
    fi
  elif (( ${#DA_COPY} || ${#DA_STALE} )); then
    print -r -- copy_pinned
  elif (( ${#DA_OLD} )); then
    print -r -- old_launcher_pinned
  elif (( ! ${#DA_LAUNCHER} )); then
    print -r -- launcher_missing
  else
    print -r -- ok
  fi
}

dock_profile_state() {
  local work=$TMP/dock-state.plist
  dock_profile_args
  dock_read "$work" || { print -r -- -; return 0; }
  dock_analyze "$work"
  dock_state
}

dock_sync() {
  local mode=$1 dry=$2 pin=$3 ask=$4
  local work=$TMP/dock-before.plist edited=$TMP/dock-after.plist
  local -a replace_idx remove_idx plan pinned_idx
  local idx need_launcher count_before count_after expected
  DOCK_CHANGED=0
  if ! dock_read "$work"; then
    warn "Could not read the Dock preferences; the Dock was left as it is."
    return 1
  fi
  dock_analyze "$work"
  need_launcher=$(( ${#DA_LAUNCHER} == 0 ))
  if [[ $mode == purge ]]; then
    pinned_idx=( $DA_COPY $DA_OLD $DA_LAUNCHER )
    for idx in ${(on)pinned_idx}; do
      remove_idx+=( $idx )
      plan+=( "remove the Dock pin at position $idx" )
    done
  else
    local stale_text="it carried the identity of the app copy" old_text="old launcher pin"
    if is_self_mode; then
      stale_text="it carried the identity of the old launcher"
      old_text="pin of the old launcher or hidden copy"
    fi
    for idx in $DA_STALE; do
      replace_idx+=( $idx )
      plan+=( "refresh the pin of $(tilde "$DOCK_LAUNCHER") at position $idx ($stale_text)" )
    done
    for idx in $DA_OLD; do
      if (( need_launcher )); then
        need_launcher=0
        replace_idx+=( $idx )
        plan+=( "point the $old_text at position $idx to $(tilde "$DOCK_LAUNCHER")" )
      else
        remove_idx+=( $idx )
        plan+=( "remove the $old_text at position $idx ($(tilde "$DOCK_LAUNCHER") is already pinned)" )
      fi
    done
    for idx in $DA_COPY; do
      if (( need_launcher )); then
        need_launcher=0
        replace_idx+=( $idx )
        plan+=( "replace the app copy pin at position $idx with $(tilde "$DOCK_LAUNCHER")" )
      else
        remove_idx+=( $idx )
        plan+=( "remove the app copy pin at position $idx ($(tilde "$DOCK_COPY"))" )
      fi
    done
    if (( need_launcher && pin )); then
      plan+=( "pin $(tilde "$DOCK_LAUNCHER")" )
    fi
  fi
  if (( ! ${#plan} )); then
    say "Dock: nothing to change."
    return 0
  fi
  local line
  say "Dock plan:"
  for line in $plan; do
    say "  - $line"
  done
  if (( dry )); then
    say "Dry run: the Dock was not changed."
    return 0
  fi
  if (( ask )); then
    confirm "Apply these changes to the Dock (it restarts)?" || { say "Cancelled."; return 0; }
  fi
  cp -- "$work" "$edited"
  local tile
  tile=$(dock_tile_xml "$DOCK_LAUNCHER" "$DOCK_LABEL")
  for idx in $replace_idx; do
    plutil -insert "persistent-apps.$idx" -xml "$tile" "$edited" && plutil -remove "persistent-apps.$(( idx + 1 ))" "$edited" || { warn "Could not edit the Dock preferences; nothing was changed."; return 1; }
  done
  for idx in ${(On)remove_idx}; do
    plutil -remove "persistent-apps.$idx" "$edited" || { warn "Could not edit the Dock preferences; nothing was changed."; return 1; }
  done
  if (( need_launcher && pin )); then
    plutil -insert persistent-apps -xml "$tile" -append "$edited" || { warn "Could not edit the Dock preferences; nothing was changed."; return 1; }
  fi
  count_before=$(plutil -extract persistent-apps raw -o - "$work")
  count_after=$(plutil -extract persistent-apps raw -o - "$edited" 2>/dev/null || print -r -- -1)
  expected=$(( count_before - ${#remove_idx} + (need_launcher && pin ? 1 : 0) ))
  if ! plutil -lint "$edited" >/dev/null 2>&1 || [[ $count_after != "$expected" ]]; then
    warn "The edited Dock preferences failed validation; nothing was changed."
    return 1
  fi
  local backup
  backup=$(dock_backup "$work")
  dock_write "$edited" || { warn "Could not write the Dock preferences. The original is saved at $(tilde "$backup")."; return 1; }
  DOCK_CHANGED=1
  say "Dock updated. Backup of the previous Dock: $(tilde "$backup")"
}

cmd_dock() {
  local target=${1:-} action=${2:-} dry=0 pin=0
  local usage_text="dock <slug> fix [--yes] [--dry-run] [--pin]"
  [[ -n $target && $action == fix ]] || usage_error "$usage_text"
  shift 2
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      --dry-run) dry=1; shift ;;
      --pin) pin=1; shift ;;
      --plain) PLAIN=1; shift ;;
      *) usage_error "$usage_text" ;;
    esac
  done
  setup_colors
  profile_load "$target"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app."
  if is_self_mode; then
    if (( ! dry )) && [[ ! -d $PROFILE_APP ]]; then
      die "App missing: $PROFILE_APP. Build it first: claude-profiles build $SLUG"
    fi
  else
    if same_path "$PROFILE_LAUNCHER" "$PROFILE_APP"; then
      die "The launcher path of \"$SLUG\" is the copy itself ($PROFILE_LAUNCHER). Fix the profile paths with: claude-profiles migrate-layout $SLUG"
    fi
    if (( ! dry )) && [[ ! -d $PROFILE_LAUNCHER ]]; then
      die "Launcher missing: $PROFILE_LAUNCHER. Build it first: claude-profiles launcher $SLUG"
    fi
  fi
  dock_profile_args
  dock_sync fix "$dry" "$pin" 1 || exit 1
}

report_layout_blockers() {
  local i state t=$'\t'
  if (( PLAIN )); then
    for (( i = 1; i <= ${#LA_LABEL}; i++ )); do
      print -r -- "agent${t}$LA_LABEL[i]${t}$LA_PLIST[i]${t}$LA_LOADED[i]${t}$LA_PROGRAM[i]"
    done
  fi
  print -u2 -r -- "WARN:  Cannot move \"$SLUG\" to the new layout yet. These old LaunchAgents reference ${PROFILE_APP:t} or $SOURCE_APP and would recreate the copy at its old path:"
  for (( i = 1; i <= ${#LA_LABEL}; i++ )); do
    state="not loaded"
    [[ $LA_LOADED[i] == 1 ]] && state=loaded
    print -u2 -r -- "  $LA_LABEL[i]  ($state, $(tilde "$LA_PLIST[i]"))"
  done
  print -u2 -r -- "Disable each one, then run: claude-profiles migrate-layout $SLUG"
  for (( i = 1; i <= ${#LA_LABEL}; i++ )); do
    print -u2 -r -- "  claude-profiles legacy-agents disable ${(q-)LA_LABEL[i]}"
  done
}

migrate_layout() {
  local mode=${1:-command}
  local old_app=$PROFILE_APP old_launcher=$PROFILE_LAUNCHER LID new_app new_launcher
  local have_old=0 have_new=0 verified_before=0 pin_note=0
  LAYOUT_BLOCKED=0
  LID=$(launcher_id)
  new_app=$APPS_DIR/${old_app:t}
  new_launcher=$LAUNCHER_DIR/${old_app:t}
  assert_app_path "$new_app"
  assert_app_path "$new_launcher"
  [[ -d $old_app ]] && have_old=1
  [[ -d $new_app ]] && have_new=1
  if (( have_old && have_new )); then
    die "Both $old_app and $new_app exist. Remove the one you do not need, then re-run."
  fi
  if (( ! have_old && ! have_new )) && [[ $mode == command ]]; then
    die "$old_app not found. Build it first: claude-profiles build $SLUG"
  fi
  if (( have_new )); then
    PROFILE_APP=$new_app
  fi
  if (( have_old || have_new )); then
    assert_ours "$PROFILE_APP" "$PROFILE_BUNDLE_ID"
    if is_running "$PROFILE_APP"; then
      die "Quit \"${old_app:t:r}\" first, then re-run."
    fi
    legacy_agents_collect "$old_app"
    if (( ${#LA_LABEL} )); then
      report_layout_blockers
      if [[ $mode == command ]]; then
        exit 3
      fi
      LAYOUT_BLOCKED=1
      PROFILE_APP=$old_app
      return 0
    fi
  fi
  if [[ -e $new_launcher ]] && ! same_path "$new_launcher" "$old_app"; then
    assert_ours "$new_launcher" "$LID"
  fi
  if (( have_old || have_new )); then
    if [[ $mode == command ]]; then
      choose_sign_id keep
    else
      choose_sign_id
    fi
  fi

  mkdir -p -- "$APPS_DIR" || die "Could not create $APPS_DIR. Create it yourself (it needs to be writable by you), then re-run."
  if (( have_old )); then
    codesign --verify --deep --strict "$old_app" >/dev/null 2>&1 && verified_before=1
    say "Moving ${old_app:t} into $APPS_DIR..."
    if ! mv -- "$old_app" "$new_app" 2>/dev/null; then
      say "mv failed; copying with ditto instead..."
      rm -rf -- "$new_app"
      if ! ditto "$old_app" "$new_app"; then
        rm -rf -- "$new_app"
        die "Could not copy $old_app to $new_app; the original was left in place."
      fi
      rm -rf -- "$old_app"
    fi
    PROFILE_APP=$new_app
  fi
  if (( have_old || have_new )); then
    if codesign --verify --deep --strict "$new_app" >/dev/null 2>&1; then
      say "Signature verified at the new path (codesign --verify --deep --strict)."
    elif (( verified_before )); then
      if mv -- "$new_app" "$old_app" 2>/dev/null; then
        PROFILE_APP=$old_app
        die "The signature of the copy no longer verifies at $new_app; moved it back to $old_app. Nothing else was changed."
      fi
      die "The signature of the copy no longer verifies at $new_app and it could not be moved back to $old_app. Rebuild it: claude-profiles build $SLUG"
    else
      warn "codesign --verify --deep --strict does not pass for $new_app (it did not pass before the move either)."
    fi
    "$LSREG" -f "$new_app" >/dev/null 2>&1 || true
    "$LSREG" -u "$old_app" >/dev/null 2>&1 || true
  fi

  if [[ -e $old_launcher ]] && ! same_path "$old_launcher" "$new_launcher" && ! same_path "$old_launcher" "$new_app"; then
    if [[ ${(L)$(plist_get "$old_launcher" CFBundleIdentifier)} == ${(L)LID} ]]; then
      pin_note=1
      "$LSREG" -u "$old_launcher" >/dev/null 2>&1 || true
      rm -rf -- "$old_launcher"
      say "Removed the old launcher ${old_launcher:t}"
    else
      warn "${old_launcher:t} is not this tool's launcher for \"$SLUG\" (bundle id $(plist_get "$old_launcher" CFBundleIdentifier)); left in place. Delete it yourself to get a single entry in search."
    fi
  fi

  PROFILE_APP=$new_app
  PROFILE_LAUNCHER=$new_launcher
  profile_save
  regen_rules
  if (( have_old || have_new )); then
    build_launcher "$(copy_icns_path "$new_app")"
  fi
  say "New layout: copy $new_app, launcher $new_launcher"
  local dock_handled=0
  if (( ! IS_AUTO )); then
    dock_profile_args "$old_launcher"
    DOCK_CHANGED=0
    if dock_sync fix 0 0 0; then
      dock_handled=1
    fi
    if (( (have_old || have_new) && ! DOCK_CHANGED )); then
      dock_restart
    fi
  fi
  if (( pin_note && ! dock_handled )); then
    say "Note: re-pin '${new_launcher:t:r}' in the Dock. The old Dock item pointed at the removed launcher: remove it, then drag $new_launcher into the Dock."
  fi
  if (( pin_note && IS_AUTO )); then
    notify "${new_launcher:t:r} moved to the new layout: re-pin it in the Dock (the old Dock item no longer works)." "${new_launcher:t:r}"
  fi
}

cmd_migrate_layout() {
  local target=""
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "migrate-layout <slug> [--yes] [--plain]" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "migrate-layout <slug> [--yes] [--plain]"
  setup_colors
  profile_load "$target"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app."
  if is_self_mode; then
    say "\"$SLUG\" already runs in self mode: one app at $PROFILE_APP, no launcher."
    return 0
  fi
  confirm "Rebuild ${PROFILE_APP:t} from $SOURCE_APP as one app at $LAUNCHER_DIR/${PROFILE_APP:t} (self mode: no launcher, no hidden copy)?" || { say "Cancelled."; return 0; }
  need_lock
  migrate_to_self
}

migrate_to_self() {
  [[ -d $PROFILE_APP ]] || die "$PROFILE_APP not found. Build it first: claude-profiles build $SLUG"
  assert_ours "$PROFILE_APP" "$PROFILE_BUNDLE_ID"
  if is_running "$PROFILE_APP"; then
    die "Quit \"${PROFILE_APP:t:r}\" first, then re-run."
  fi
  legacy_agents_collect "$PROFILE_APP"
  if (( ${#LA_LABEL} )); then
    report_layout_blockers
    exit 3
  fi
  [[ -d $SOURCE_APP ]] || die "Not found: $SOURCE_APP"
  if ! asar_validate "$SOURCE_APP"; then
    warn "Self mode is not possible with $SOURCE_APP $(app_version "$SOURCE_APP"): $ASAR_REASON."
    if [[ $(layout_of_profile) == legacy ]]; then
      warn "Moving \"$SLUG\" to the hidden launcher layout instead."
      migrate_layout command
      return 0
    fi
    die "\"$SLUG\" stays in launcher mode."
  fi
  BUILD_MODE=self
  build_profile "$SLUG"
}

build_target_mode() {
  if [[ -n $BUILD_MODE ]]; then
    print -r -- "$BUILD_MODE"
  elif (( KEEP_MODE )); then
    print -r -- "$PROFILE_MODE"
  else
    print -r -- self
  fi
}

assert_ours_either() {
  local target=$1 first=$2 second=$3 id
  [[ -e $target ]] || return 0
  id=$(plist_get "$target" CFBundleIdentifier)
  if [[ ${(L)id} != ${(L)first} && ${(L)id} != ${(L)second} && ${(L)id} != ${(L)$(src_id)} ]]; then
    die "$target exists and belongs to another app (bundle id \"$id\", expected \"$first\" or \"$second\"). Refusing to touch it."
  fi
}

remove_replaced_app() {
  local target=$1 expected=$2 parent
  [[ -n $target && -e $target ]] || return 0
  if [[ ${(L)$(plist_get "$target" CFBundleIdentifier)} != ${(L)expected} ]]; then
    warn "${target:t} is not this tool's app for \"$SLUG\" (bundle id $(plist_get "$target" CFBundleIdentifier)); left in place."
    return 0
  fi
  parent=${target:h}
  "$LSREG" -u "$target" >/dev/null 2>&1 || true
  rm -rf -- "$target"
  say "Removed $target"
  if same_path "$parent" "$APPS_DIR"; then
    rmdir -- "$APPS_DIR" 2>/dev/null || true
  fi
}

build_profile() {
  profile_load "$1"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app (CLI only)."
  [[ -d $SOURCE_APP ]] || die "Not found: $SOURCE_APP"
  source_team_ok || die "$SOURCE_APP is not validly signed by Apple Team ID $SOURCE_TEAM_ID (SOURCE_TEAM_ID in $CONFIG_FILE). Refusing to copy it. Set SOURCE_TEAM_ID to the right Team ID, or to an empty value to disable this check."
  local mode LID old_app old_launcher old_mode=$PROFILE_MODE
  LID=$(launcher_id)
  mode=$(build_target_mode)
  if [[ $mode == self ]] && ! asar_validate "$SOURCE_APP"; then
    warn "Self mode is not possible with $SOURCE_APP $(app_version "$SOURCE_APP"): $ASAR_REASON. Falling back to launcher mode."
    mode=launcher
  fi
  if [[ $mode == self ]] && ! is_self_mode && [[ -d $PROFILE_APP ]]; then
    legacy_agents_collect "$PROFILE_APP"
    if (( ${#LA_LABEL} )); then
      report_layout_blockers
      warn "Rebuilding in launcher mode for now. After disabling the agents above, run: claude-profiles migrate-layout $SLUG"
      mode=launcher
    fi
  fi
  if [[ $mode == launcher ]] && ! is_self_mode && [[ $(layout_of_profile) == legacy ]] && has_old_launcher_naming; then
    say "Old layout found: moving the copy into $APPS_DIR first."
    migrate_layout build
    if (( LAYOUT_BLOCKED )); then
      warn "Rebuilding in the old layout for now. After disabling the agents above, run: claude-profiles migrate-layout $SLUG"
    fi
  fi
  if same_path "$PROFILE_DATA_DIR" "$MAIN_DATA_DIR"; then
    die "PROFILE_DATA_DIR is the main Claude data dir; pick another one."
  fi
  if [[ -n $PROFILE_COLOR ]]; then
    resolve_color "$PROFILE_COLOR"
    profile_save
  fi
  choose_sign_id

  old_app=$PROFILE_APP
  old_launcher=$PROFILE_LAUNCHER
  if [[ $mode == self ]]; then
    is_self_mode || PROFILE_APP=$LAUNCHER_DIR/${old_app:t}
    PROFILE_LAUNCHER=
    PROFILE_MODE=self
  elif is_self_mode; then
    PROFILE_MODE=launcher
    PROFILE_APP=$APPS_DIR/${old_app:t}
    PROFILE_LAUNCHER=$LAUNCHER_DIR/${old_app:t}
  fi
  local DST=$PROFILE_APP NAME=${PROFILE_APP:t:r} running
  assert_app_path "$DST"
  if [[ $mode == self ]]; then
    assert_ours_either "$DST" "$PROFILE_BUNDLE_ID" "$LID"
  else
    assert_ours "$DST" "$PROFILE_BUNDLE_ID"
    if [[ $old_mode == self ]]; then
      assert_ours_either "$PROFILE_LAUNCHER" "$LID" "$PROFILE_BUNDLE_ID"
    else
      assert_ours "$PROFILE_LAUNCHER" "$LID"
    fi
  fi
  mkdir -p -- "${DST:h}" || die "Could not create ${DST:h}."
  for running in "$DST" "$old_app"; do
    if is_running "$running"; then
      die "Quit \"${running:t:r}\" first, then re-run."
    fi
  done

  local STAGE="$DST.new"
  rm -rf -- "$STAGE_DIR" "$DST.new"
  mkdir -p -- "$STAGE_DIR"
  CLEANUP_PATHS+=( "$STAGE_DIR" "$DST.new" )
  if [[ $(/usr/bin/stat -f %d "$STAGE_DIR") == $(/usr/bin/stat -f %d "${DST:h}") ]]; then
    STAGE="$STAGE_DIR/${DST:t}"
  fi

  renew_lock
  say "Copying app..."
  ditto "$SOURCE_APP" "$STAGE"

  local PLIST="$STAGE/Contents/Info.plist"
  plutil -replace CFBundleIdentifier -string "$PROFILE_BUNDLE_ID" "$PLIST"
  plutil -replace CFBundleDisplayName -string "$NAME" "$PLIST"
  if is_main_config "$PROFILE_CONFIG_DIR"; then
    plutil -remove LSEnvironment.CLAUDE_CONFIG_DIR "$PLIST" 2>/dev/null || true
  else
    if ! plutil -extract LSEnvironment xml1 -o /dev/null "$PLIST" 2>/dev/null; then
      plutil -insert LSEnvironment -dictionary "$PLIST"
    fi
    plutil -replace LSEnvironment.CLAUDE_CONFIG_DIR -string "$PROFILE_CONFIG_DIR" "$PLIST"
  fi

  local EXE
  EXE=$($PB -c "Print :CFBundleExecutable" "$PLIST")

  renew_lock
  say "Tinting icon${PROFILE_COLOR:+ to $PROFILE_COLOR}..."
  plutil -remove CFBundleIconName "$PLIST" 2>/dev/null || true
  local ICON_FILE ICNS=""
  ICON_FILE=$($PB -c "Print :CFBundleIconFile" "$PLIST" 2>/dev/null || true)
  if [[ -n $ICON_FILE ]]; then
    ICNS="$STAGE/Contents/Resources/${ICON_FILE%.icns}.icns"
  else
    local -a found
    found=( "$STAGE"/Contents/Resources/*.icns(N) )
    ICNS=${found[1]:-}
    if [[ -n $ICNS ]]; then
      plutil -insert CFBundleIconFile -string "${ICNS:t}" "$PLIST"
    fi
  fi
  if [[ -n $PROFILE_COLOR && -f ${ICNS:-} ]]; then
    tint_icns "$ICNS" "$ICNS" "$PROFILE_COLOR" || warn "Tinting failed; icon left unchanged."
  elif [[ -n $PROFILE_COLOR ]]; then
    warn "No usable .icns found; icon left unchanged."
  fi

  if [[ $mode == self ]]; then
    renew_lock
    say "Adding the boot file to app.asar (self mode)..."
    patch_asar "$STAGE" || die "Could not patch app.asar of the staged copy; nothing was changed. Rebuild in launcher mode with: claude-profiles build $SLUG --mode launcher"
  fi

  renew_lock
  say "Re-signing (takes a minute)..."
  xattr -cr "$STAGE"
  local f
  {
    find "$STAGE/Contents" -type d \( -name '*.app' -o -name '*.framework' -o -name '*.xpc' -o -name '*.appex' \) -print0
    find "$STAGE/Contents" -type f \( -perm -u+x -o -name '*.dylib' -o -name '*.node' -o -name '*.so' \) -print0 \
      | while IFS= read -r -d '' f; do { file -b "$f" | grep -q Mach-O && printf '%s\0' "$f"; } || true; done
  } | while IFS= read -r -d '' f; do
        printf '%d\t%s\n' "$(tr -cd / <<<"$f" | wc -c)" "$f"
      done | sort -rn | cut -f2- | while IFS= read -r f; do
        [[ $f == "$STAGE/Contents/MacOS/$EXE" ]] && continue
        sign_one "$f" || warn "could not sign: ${f#$STAGE/}"
      done || true
  sign_one "$STAGE/Contents/MacOS/$EXE" "$PROFILE_BUNDLE_ID"
  sign_bundle "$STAGE"
  codesign --verify --deep --strict "$STAGE" 2>/dev/null || warn "codesign --verify reported problems (may still launch)."

  for running in "$DST" "$old_app"; do
    if is_running "$running"; then
      rm -rf -- "$STAGE"
      die "\"${running:t:r}\" was started during the build; staged copy discarded. Quit it and re-run."
    fi
  done
  renew_lock
  say "Swapping into place..."
  if [[ -e $DST && ${(L)$(plist_get "$DST" CFBundleIdentifier)} == ${(L)LID} ]]; then
    "$LSREG" -u "$DST" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$DST.old"
  if [[ -e $DST ]]; then
    mv -- "$DST" "$DST.old"
  fi
  if ! mv -- "$STAGE" "$DST"; then
    if [[ -e $DST.old ]]; then
      mv -- "$DST.old" "$DST"
    fi
    die "Could not move the staged build into place; the previous copy was kept."
  fi
  touch -- "$DST"
  "$LSREG" -f "$DST" >/dev/null 2>&1 || true
  if [[ $mode == self ]]; then
    profile_save
    rm -rf -- "$DST.old"
  else
    local LAUNCHER_STAGE=$TMP/launcher-stage/${PROFILE_LAUNCHER:t}
    if ! stage_launcher "$(copy_icns_path "$DST")" "$LAUNCHER_STAGE" || ! install_launcher "$LAUNCHER_STAGE"; then
      "$LSREG" -u "$DST" >/dev/null 2>&1 || true
      rm -rf -- "$DST"
      if [[ -e $DST.old ]]; then
        mv -- "$DST.old" "$DST"
        "$LSREG" -f "$DST" >/dev/null 2>&1 || true
      fi
      die "Could not build the launcher at $PROFILE_LAUNCHER; the previous app and profile were kept."
    fi
    profile_save
    rm -rf -- "$DST.old" "$PROFILE_LAUNCHER.old"
  fi
  if ! same_path "$old_app" "$DST" && { [[ $mode == self ]] || ! same_path "$old_app" "$PROFILE_LAUNCHER"; }; then
    remove_replaced_app "$old_app" "$PROFILE_BUNDLE_ID"
  fi
  if [[ $mode == self && -n $old_launcher ]] && ! same_path "$old_launcher" "$DST"; then
    remove_replaced_app "$old_launcher" "$LID"
  fi
  if (( ! IS_AUTO )); then
    if [[ $old_mode != $PROFILE_MODE ]]; then
      dock_profile_args "$old_app" "$old_launcher"
      DOCK_CHANGED=0
      dock_sync fix 0 0 0 || true
      (( DOCK_CHANGED )) || dock_restart
    else
      dock_restart
    fi
  elif [[ $old_mode != $PROFILE_MODE ]]; then
    notify "$NAME now runs in $PROFILE_MODE mode. If its Dock icon misbehaves, run: claude-profiles dock $SLUG fix" "$NAME"
  fi
  say "Done: $DST"
  if is_self_mode; then
    say "Mode: self (one app per profile; no launcher)"
  else
    say "Launcher: $PROFILE_LAUNCHER"
  fi
  say "Data: $PROFILE_DATA_DIR"
  say "Config: $PROFILE_CONFIG_DIR"
  if (( ! IS_AUTO )); then
    if is_self_mode; then
      say "Next: pin '$NAME' (${DST:h}) to the Dock, open it, then run: claude-profiles check $SLUG"
    else
      say "Next: pin '${PROFILE_LAUNCHER:t:r}' (${PROFILE_LAUNCHER:h}) to the Dock, open it, then run: claude-profiles check $SLUG"
    fi
  fi
}

stale_reason() {
  local key
  if [[ ! -d $PROFILE_APP ]]; then
    print -r -- "${PROFILE_APP:t:r} is missing"
    return 0
  fi
  if [[ ${(L)$(plist_get "$PROFILE_APP" CFBundleIdentifier)} != ${(L)PROFILE_BUNDLE_ID} ]]; then
    print -r -- "bundle id is $(plist_get "$PROFILE_APP" CFBundleIdentifier), not $PROFILE_BUNDLE_ID (overwritten by the copy's own updater?)"
    return 0
  fi
  for key in CFBundleShortVersionString CFBundleVersion; do
    if [[ $(plist_get "$SOURCE_APP" $key) != "$(plist_get "$PROFILE_APP" $key)" ]]; then
      print -r -- "$key differs: source $(plist_get "$SOURCE_APP" $key), copy $(plist_get "$PROFILE_APP" $key)"
      return 0
    fi
  done
  if is_self_mode; then
    asar_boot_state "$PROFILE_APP" || true
    if (( ! BOOT_PRESENT || ! BOOT_ENTRY_OK || ! BOOT_MAIN_OK )); then
      print -r -- "self-mode boot entry $ASAR_BOOT_FILE is missing or not wired into package.json"
      return 0
    fi
    if (( BOOT_VERSION != ASAR_BOOT_VERSION )); then
      print -r -- "boot entry is version $BOOT_VERSION, this tool writes version $ASAR_BOOT_VERSION"
      return 0
    fi
    if (( ! BOOT_HASH_OK )); then
      print -r -- "ElectronAsarIntegrity in Info.plist does not match the app.asar header"
      return 0
    fi
    if [[ $BOOT_DATA != "$PROFILE_DATA_DIR" ]]; then
      print -r -- "boot entry uses the data dir $BOOT_DATA, the profile uses $PROFILE_DATA_DIR"
      return 0
    fi
    if [[ $BOOT_CONFIG != "$(boot_config_dir)" ]]; then
      print -r -- "boot entry uses the config dir ${BOOT_CONFIG:-~/.claude}, the profile uses $PROFILE_CONFIG_DIR"
      return 0
    fi
  elif [[ ! -d $PROFILE_LAUNCHER ]]; then
    print -r -- "launcher app is missing"
    return 0
  fi
  if ! is_main_config "$PROFILE_CONFIG_DIR" && [[ $(plist_get "$PROFILE_APP" LSEnvironment:CLAUDE_CONFIG_DIR) != "$PROFILE_CONFIG_DIR" ]]; then
    print -r -- "copy lacks LSEnvironment:CLAUDE_CONFIG_DIR=$PROFILE_CONFIG_DIR"
    return 0
  fi
  resolve_sign_identity
  if [[ $SIGN_ID != - ]]; then
    local signature
    signature=$(codesign -dvv "$PROFILE_APP" 2>&1 || true)
    if ! grep -qxF "Authority=$SIGN_ID" <<<"$signature"; then
      print -r -- "copy is not signed by \"$SIGN_ID\" (ad-hoc, mixed or other) although the identity is usable"
      return 0
    fi
  fi
  return 1
}

scan_collect() {
  SC_CFG=() SC_CFG_N=() SC_DATA=()
  SP_CFG=() SP_DIR=() SP_CWD=() SP_N=() SP_MTIME=()
  local SLUG ${PROFILE_KEYS[@]} s c d key cwd f mt
  local -a PROFILE_DIRS reply cands dcands files mtimes pdirs
  local -A seen
  cands=( "$MAIN_CONFIG_DIR" "$HOME"/.claude-*(N-/) )
  dcands=( "$HOME/Library/Application Support"/Claude-*(N-/) )
  all_slugs
  for s in $reply; do
    profile_load "$s"
    cands+=( "$PROFILE_CONFIG_DIR" )
    if (( PROFILE_DESKTOP )); then
      dcands+=( "$PROFILE_DATA_DIR" )
    fi
  done
  for c in $cands; do
    [[ -d $c ]] || continue
    key=${c:A}
    (( ! ${+seen[$key]} )) || continue
    seen[$key]=1
    if [[ -d $c/projects || -f $c/.claude.json || -f $c/settings.json ]] || is_main_config "$c"; then
      pdirs=( "$c"/projects/*(N-/) )
      SC_CFG+=( "$c" )
      SC_CFG_N+=( ${#pdirs} )
    fi
  done
  for d in $dcands; do
    [[ -d $d ]] || continue
    key=${d:A}
    (( ! ${+seen[$key]} )) || continue
    seen[$key]=1
    same_path "$d" "$MAIN_DATA_DIR" && continue
    if [[ -e $d/Preferences || -e "$d/Local State" || -d "$d/Local Storage" || -d $d/claude-code-sessions || -f $d/config.json ]]; then
      SC_DATA+=( "$d" )
    fi
  done
  for c in $SC_CFG; do
    for d in "$c"/projects/*(N-/); do
      files=( "$d"/*.jsonl(N-.om) )
      (( ${#files} )) || continue
      cwd=""
      for f in ${files[1,3]}; do
        cwd=$(extract_cwd "$f" || true)
        [[ -n $cwd ]] && break
      done
      [[ -n $cwd ]] || continue
      zstat -A mtimes +mtime -- "$files[1]"
      SP_CFG+=( "$c" )
      SP_DIR+=( "${d:t}" )
      SP_CWD+=( "$cwd" )
      SP_N+=( ${#files} )
      SP_MTIME+=( "$mtimes[1]" )
    done
  done
}

extract_cwd() {
  local m
  m=$(grep -m1 -oE '"cwd":"([^"\\]|\\.)*"' -- "$1" 2>/dev/null) || return 1
  m=${m%%$'\n'*}
  m=${m#\"cwd\":\"}
  m=${m%\"}
  m=${m//\\\//\/}
  m=${m//\\\"/\"}
  m=${m//\\\\/\\}
  print -r -- "$m"
}

applescript_string_body() {
  local s=$1 out="" c i
  for (( i = 1; i <= ${#s}; i++ )); do
    c=${s[i]}
    if [[ $c == '\' ]]; then
      (( i++ ))
      out+=${s[i]}
    elif [[ $c == '"' ]]; then
      break
    else
      out+=$c
    fi
  done
  print -r -- "$out"
}

shell_first_word() {
  local s=$1 out="" c i quote=""
  for (( i = 1; i <= ${#s}; i++ )); do
    c=${s[i]}
    case $quote in
      '"')
        if [[ $c == '"' ]]; then
          quote=""
        elif [[ $c == '\' && ${s[i+1]} == (\"|\\|\$|\`) ]]; then
          (( i++ ))
          out+=${s[i]}
        else
          out+=$c
        fi ;;
      "'")
        if [[ $c == "'" ]]; then quote=""; else out+=$c; fi ;;
      *)
        if [[ $c == [[:space:]] ]]; then
          break
        elif [[ $c == '"' || $c == "'" ]]; then
          quote=$c
        elif [[ $c == '\' ]]; then
          (( i++ ))
          out+=${s[i]}
        else
          out+=$c
        fi ;;
    esac
  done
  print -r -- "$out"
}

launcher_setting() {
  local decompiled=$1 pattern=$2 line="" candidate before rest body value
  for candidate in ${(f)decompiled}; do
    if [[ $candidate == *"$pattern"* ]]; then
      line=$candidate
      break
    fi
  done
  [[ -n $line ]] || { print -r -- -; return 0; }
  before=${line%%"$pattern"*}
  rest=${line#*"$pattern"}
  body=$(applescript_string_body "$rest")
  if [[ $before =~ 'quoted form of[[:space:]]+"$' ]]; then
    value=$body
  else
    value=$(shell_first_word "$body")
  fi
  case $value in
    '$HOME'|'$HOME'/*) value=$HOME${value#'$HOME'} ;;
    '${HOME}'|'${HOME}'/*) value=$HOME${value#'${HOME}'} ;;
    '~'|'~'/*) value=$HOME${value#'~'} ;;
  esac
  [[ $value == /* ]] || value=
  print -r -- "${value:--}"
}

is_profile_app() {
  local app=$1 bundle_id=$2 s
  local SLUG ${PROFILE_KEYS[@]}
  local -a PROFILE_DIRS reply
  all_slugs
  for s in $reply; do
    profile_load "$s"
    if same_path "$PROFILE_APP" "$app" || [[ ${(L)PROFILE_BUNDLE_ID} == ${(L)bundle_id} ]]; then
      return 0
    fi
  done
  return 1
}

scan_candidates() {
  SC_CAND=()
  local app bundle_id launcher decompiled data_dir config_dir identity name base dir t=$'\t'
  local source_id old_launcher new_launcher
  local -a apps dirs
  source_id=$(src_id)
  dirs=( "$APPS_DIR" )
  same_path "$LAUNCHER_DIR" "$APPS_DIR" || dirs+=( "$LAUNCHER_DIR" )
  for dir in $dirs; do
    apps+=( "$dir"/*.app(N-/) )
  done
  for app in $apps; do
    base=${app:t:r}
    has_control_chars "$base" && continue
    bundle_id=$(plist_get "$app" CFBundleIdentifier)
    [[ $bundle_id == "$BUNDLE_ID_PREFIX".* ]] || continue
    [[ $bundle_id != *.launcher ]] || continue
    same_path "$app" "$SOURCE_APP" && continue
    [[ ${(L)bundle_id} != ${(L)source_id} ]] || continue
    is_profile_app "$app" "$bundle_id" && continue
    launcher=- data_dir= config_dir= identity=
    identity=$(usable_app_identity "$app" || true)
    old_launcher="${app%.app} Launcher.app"
    new_launcher="$LAUNCHER_DIR/${app:t}"
    if [[ -d $old_launcher ]]; then
      launcher=$old_launcher
    elif ! same_path "$new_launcher" "$app" && [[ -d $new_launcher && ${(L)$(plist_get "$new_launcher" CFBundleIdentifier)} == ${(L)bundle_id}.launcher ]]; then
      launcher=$new_launcher
    fi
    if [[ $launcher != - ]]; then
      decompiled=$(osadecompile "$launcher/Contents/Resources/Scripts/main.scpt" 2>/dev/null || true)
      data_dir=$(launcher_setting "$decompiled" '--user-data-dir=')
      config_dir=$(launcher_setting "$decompiled" 'CLAUDE_CONFIG_DIR=')
      [[ $data_dir == - ]] && data_dir=
      [[ $config_dir == - ]] && config_dir=
    elif asar_boot_state "$app" && (( BOOT_PRESENT )); then
      data_dir=$BOOT_DATA
      config_dir=$BOOT_CONFIG
    fi
    [[ -n $config_dir ]] || config_dir=$(plist_get "$app" LSEnvironment:CLAUDE_CONFIG_DIR)
    name=${base#Claude }
    has_control_chars "$data_dir$config_dir" && continue
    SC_CAND+=( "$app$t$launcher$t$bundle_id$t${data_dir:--}$t${config_dir:--}$t$name$t${identity:--}" )
  done
}

iso_time() {
  strftime '%Y-%m-%dT%H:%M:%S%z' "$1"
}

tilde() {
  if [[ $1 == $HOME || $1 == $HOME/* ]]; then
    print -r -- "~${1#$HOME}"
  else
    print -r -- "$1"
  fi
}

cmd_scan() {
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "scan [--plain]" ;;
    esac
  done
  setup_colors
  load_rules
  scan_collect
  scan_candidates
  local i
  if (( PLAIN )); then
    for (( i = 1; i <= ${#SC_CFG}; i++ )); do
      print -r -- "config"$'\t'"$SC_CFG[i]"$'\t'"$SC_CFG_N[i]"
    done
    for i in $SC_DATA; do
      print -r -- "data"$'\t'"$i"
    done
    for (( i = 1; i <= ${#SP_CFG}; i++ )); do
      print -r -- "project"$'\t'"$SP_CFG[i]"$'\t'"$SP_CWD[i]"$'\t'"$SP_N[i]"$'\t'"$(iso_time $SP_MTIME[i])"$'\t'"$(rule_owner "$SP_CWD[i]")"
    done
    for i in $SC_CAND; do
      print -r -- "candidate"$'\t'"$i"
    done
    return 0
  fi
  say "${C_BOLD}Config dirs${C_RESET}"
  for (( i = 1; i <= ${#SC_CFG}; i++ )); do
    say "  $(tilde "$SC_CFG[i]")  ${C_DIM}$SC_CFG_N[i] projects${C_RESET}"
  done
  say "${C_BOLD}Desktop data dirs${C_RESET}"
  if (( ${#SC_DATA} == 0 )); then
    say "  ${C_DIM}none besides the main one${C_RESET}"
  fi
  for i in $SC_DATA; do
    say "  $(tilde "$i")"
  done
  say "${C_BOLD}Projects${C_RESET}"
  for (( i = 1; i <= ${#SP_CFG}; i++ )); do
    say "  $(tilde "$SP_CWD[i]")  ${C_DIM}in $(tilde "$SP_CFG[i]"), $SP_N[i] sessions, last $(strftime '%Y-%m-%d %H:%M' $SP_MTIME[i]), owner $(rule_owner "$SP_CWD[i]")${C_RESET}"
  done
  say "${C_BOLD}Existing copies you can adopt${C_RESET}"
  if (( ${#SC_CAND} == 0 )); then
    say "  ${C_DIM}none${C_RESET}"
  fi
  local -a fields
  for i in $SC_CAND; do
    fields=( "${(@ps:\t:)i}" )
    say "  $(tilde "$fields[1]")  ${C_DIM}name $fields[6], data $(tilde "$fields[4]"), config $(tilde "$fields[5]"), signed by ${fields[7]:--}${C_RESET}"
  done
}

cmd_list() {
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "list [--plain]" ;;
    esac
  done
  setup_colors
  local SLUG ${PROFILE_KEYS[@]} s app data color
  local -a PROFILE_DIRS reply
  local t=$'\t'
  if (( PLAIN )); then
    print -r -- "default${t}Claude${t}-${t}1${t}$SOURCE_APP${t}$MAIN_CONFIG_DIR${t}$MAIN_DATA_DIR"
  else
    say "${C_BOLD}default${C_RESET}  Claude  ${C_DIM}$(tilde "$SOURCE_APP")  config $(tilde "$MAIN_CONFIG_DIR")${C_RESET}"
  fi
  all_slugs
  for s in $reply; do
    profile_load "$s"
    app=$PROFILE_APP data=$PROFILE_DATA_DIR color=${PROFILE_COLOR:--}
    if (( ! PROFILE_DESKTOP )); then
      app=- data=-
    fi
    if (( PLAIN )); then
      print -r -- "$SLUG${t}$PROFILE_NAME${t}$color${t}$PROFILE_DESKTOP${t}$app${t}$PROFILE_CONFIG_DIR${t}$data"
    else
      local swatch=""
      if [[ -n $C_RESET && $color == \#[0-9a-f](#c6) ]]; then
        swatch=$'\e[38;2;'"$(( 16#${color[2,3]} ));$(( 16#${color[4,5]} ));$(( 16#${color[6,7]} ))m"'●'"$C_RESET "
      fi
      local kind=() where=""
      (( PROFILE_DESKTOP )) && kind+=( desktop )
      (( PROFILE_CLI )) && kind+=( cli )
      [[ $app == - ]] || where="$(tilde "$app")  "
      say "${swatch}${C_BOLD}$SLUG${C_RESET}  $PROFILE_NAME  ${C_DIM}${(j:+:)kind}  ${where}config $(tilde "$PROFILE_CONFIG_DIR")${C_RESET}"
    fi
  done
}

cmd_show() {
  local slug=""
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      -*) usage_error "show <slug>" ;;
      *) slug=$1; shift ;;
    esac
  done
  [[ -n $slug ]] || usage_error "show <slug>"
  setup_colors
  local t=$'\t'
  if [[ $slug == default ]]; then
    if (( PLAIN )); then
      print -r -- "slug${t}default"
      print -r -- "name${t}Claude"
      print -r -- "color${t}-"
      print -r -- "sign_identity${t}-"
      print -r -- "desktop${t}1"
      print -r -- "cli${t}1"
      print -r -- "app${t}$SOURCE_APP"
      print -r -- "launcher${t}-"
      print -r -- "layout${t}-"
      print -r -- "mode${t}-"
      print -r -- "dock${t}-"
      print -r -- "bundle_id${t}$(src_id)"
      print -r -- "data_dir${t}$MAIN_DATA_DIR"
      print -r -- "config_dir${t}$MAIN_CONFIG_DIR"
      return 0
    fi
    say "slug        default"
    say "name        Claude"
    say "app         $SOURCE_APP ($(app_version "$SOURCE_APP"))"
    say "config_dir  $MAIN_CONFIG_DIR"
    say "data_dir    $MAIN_DATA_DIR"
    return 0
  fi
  profile_load "$slug"
  if (( PLAIN )); then
    local app=$PROFILE_APP launcher=${PROFILE_LAUNCHER:--} bundle_id=$PROFILE_BUNDLE_ID data_dir=$PROFILE_DATA_DIR layout dock d mode=$PROFILE_MODE
    layout=$(layout_of_profile)
    dock=-
    if (( PROFILE_DESKTOP )); then
      dock=$(dock_profile_state)
    else
      app=- launcher=- bundle_id=- data_dir=- layout=- mode=-
    fi
    print -r -- "slug${t}$SLUG"
    print -r -- "name${t}$PROFILE_NAME"
    print -r -- "color${t}${PROFILE_COLOR:--}"
    print -r -- "sign_identity${t}${PROFILE_SIGN_IDENTITY:--}"
    print -r -- "desktop${t}$PROFILE_DESKTOP"
    print -r -- "cli${t}$PROFILE_CLI"
    print -r -- "app${t}$app"
    print -r -- "launcher${t}$launcher"
    print -r -- "layout${t}$layout"
    print -r -- "mode${t}$mode"
    print -r -- "dock${t}$dock"
    print -r -- "bundle_id${t}$bundle_id"
    print -r -- "data_dir${t}$data_dir"
    print -r -- "config_dir${t}$PROFILE_CONFIG_DIR"
    for d in $PROFILE_DIRS; do
      print -r -- "dir${t}$d"
    done
    return 0
  fi
  local state=-
  if (( PROFILE_DESKTOP )); then
    if [[ -d $PROFILE_APP ]]; then
      state="built, $(app_version "$PROFILE_APP")"
      if is_running "$PROFILE_APP"; then
        state+=", running"
      fi
    else
      state="not built"
    fi
  fi
  say "slug        $SLUG"
  say "name        $PROFILE_NAME"
  say "color       ${PROFILE_COLOR:--}"
  say "signing     ${PROFILE_SIGN_IDENTITY:-automatic}"
  say "desktop     $PROFILE_DESKTOP"
  say "cli         $PROFILE_CLI"
  say "app         $PROFILE_APP ($state)"
  say "launcher    ${PROFILE_LAUNCHER:--}"
  if (( PROFILE_DESKTOP )); then
    case $(layout_of_profile) in
      self) say "mode        self (one app per profile; no launcher)" ;;
      legacy) say "mode        launcher, legacy layout (run: claude-profiles migrate-layout $SLUG)" ;;
      *) say "mode        launcher, hidden copy (run: claude-profiles migrate-layout $SLUG)" ;;
    esac
    local dock_now
    dock_now=$(dock_profile_state)
    case $dock_now in
      copy_pinned|old_launcher_pinned) say "dock        $dock_now (run: claude-profiles dock $SLUG fix)" ;;
      *) say "dock        $dock_now" ;;
    esac
  fi
  say "bundle_id   $PROFILE_BUNDLE_ID"
  say "data_dir    $PROFILE_DATA_DIR"
  say "config_dir  $PROFILE_CONFIG_DIR"
  if (( ${#PROFILE_DIRS} )); then
    say "dirs        ${(j:, :)PROFILE_DIRS}"
  else
    say "dirs        -"
  fi
}

find_project_source() {
  local cwd=$1 target_cfg=$2 i best=0 best_mtime=-1 count=0
  for (( i = 1; i <= ${#SP_CWD}; i++ )); do
    [[ $SP_CWD[i] == "$cwd" ]] || continue
    same_path "$SP_CFG[i]" "$target_cfg" && continue
    count=$(( count + 1 ))
    if (( SP_MTIME[i] > best_mtime )); then
      best=$i
      best_mtime=$SP_MTIME[i]
    fi
  done
  if (( count > 1 )); then
    warn "$cwd has history in $count config dirs; using the most recent one: $SP_CFG[best]"
  fi
  print -r -- "$best"
}

claude_running() {
  pgrep -x claude >/dev/null 2>&1 || [[ -n $(app_main_pids "$SOURCE_APP") ]]
}

link_project() {
  local src_cfg=$1 dir=$2 cwd=$3 mode=$4 target_cfg=$5
  local src="$src_cfg/projects/$dir" dst="$target_cfg/projects/$dir" src_json dst_json
  src_json=$(claude_json_for "$src_cfg")
  dst_json=$(claude_json_for "$target_cfg")
  if [[ -e $dst || -L $dst ]]; then
    warn "$dst already exists; skipping $cwd"
    return 0
  fi
  mkdir -p -- "$target_cfg/projects"
  case $mode in
    symlink) ln -s -- "${src:A}" "$dst" ;;
    copy) ditto "$src" "$dst" ;;
    move) mv -- "$src" "$dst" ;;
  esac
  local json_mode=copy
  [[ $mode == move ]] && json_mode=move
  if [[ -f $src_json ]]; then
    local json_status=0
    jxa json.js "$json_mode" "$src_json" "$dst_json" "$cwd" >/dev/null 2>"$TMP/json.err" || json_status=$?
    if (( json_status == 3 )); then
      say "  ${C_DIM}no .claude.json entry for $cwd (nothing to $json_mode)${C_RESET}"
    elif (( json_status != 0 )); then
      warn "could not $json_mode the .claude.json entry for $cwd: $(<$TMP/json.err)"
    fi
  fi
  say "Linked $cwd ($mode) from $(tilde "$src_cfg") into $(tilde "$target_cfg")"
}

pick_from_menu() {
  local title=$1
  shift
  local i
  print -u2 -r -- "$title"
  print -u2 -r -- "  0) create new"
  for (( i = 1; i <= $#; i++ )); do
    print -u2 -r -- "  $i) ${@[i]}"
  done
  ask "Choice [0]: " 0
  [[ $REPLY == <-> ]] && (( REPLY <= $# )) || usage_error "invalid choice: $REPLY"
}

cmd_new() {
  local name="" slug="" color_kind="" color_value="" desktop="" cli="" data_dir="" config_dir="" link_mode="" no_build=0 mode=$BUILD_MODE
  local -a dirs links reply cfg_labels link_choices link_labels link_src_cfg link_src_dir link_cwd
  local i n l d cwd idx other_slug other_data other_cfg palette_color
  while (( $# )); do
    case $1 in
      --name) need_value "$@"; name=$2; shift 2 ;;
      --slug) need_value "$@"; slug=$2; shift 2 ;;
      --color) need_value "$@"; color_kind=hex; color_value=$2; shift 2 ;;
      --hue) (( $# >= 2 )) || usage_error "--hue needs a value"; color_kind=hue; color_value=$2; shift 2 ;;
      --pick-color) color_kind=pick; shift ;;
      --desktop) desktop=1; shift ;;
      --no-desktop) desktop=0; shift ;;
      --cli) cli=1; shift ;;
      --no-cli) cli=0; shift ;;
      --data-dir) need_value "$@"; data_dir=$2; shift 2 ;;
      --config-dir) need_value "$@"; config_dir=$2; shift 2 ;;
      --dir) need_value "$@"; dirs+=( "$2" ); shift 2 ;;
      --link) need_value "$@"; links+=( "$2" ); shift 2 ;;
      --link-mode) need_value "$@"; link_mode=$2; shift 2 ;;
      --no-build) no_build=1; shift ;;
      --mode) need_value "$@"; mode=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      *) usage_error "new: unknown option $1" ;;
    esac
  done
  setup_colors
  reject_control_chars "new options" "$name" "$slug" "$data_dir" "$config_dir" "$color_value" "${dirs[@]}" "${links[@]}"
  [[ -z $mode || $mode == (self|launcher) ]] || usage_error "--mode must be self or launcher"
  ensure_config
  local interactive=0
  can_prompt && interactive=1

  if [[ -z $name ]]; then
    (( interactive )) || usage_error "new --name N is required with --yes or without a terminal"
    ask "Profile name (e.g. Work): "
    name=$REPLY
  fi
  valid_name "$name" || usage_error "invalid name \"$name\" (no / : \" \\ or tabs, no leading/trailing spaces)"
  [[ -n $slug ]] || slug=$(slugify "$name")
  [[ -n $slug ]] || usage_error "could not derive a slug from \"$name\"; pass --slug"
  valid_slug "$slug" || usage_error "invalid slug \"$slug\" (lowercase letters, digits, dashes; not default/main/all)"
  if profile_exists "$slug"; then
    die "Profile \"$slug\" already exists — run \`claude-profiles build $slug\` to retry the build (or \`claude-profiles remove $slug\` to start over)."
  fi

  if [[ -z $desktop ]]; then
    desktop=1
    if (( interactive )); then
      ask "Create a desktop app for \"$name\"? [Y/n] " y
      [[ $REPLY == [nN]* ]] && desktop=0
    fi
  fi
  if [[ -z $cli ]]; then
    cli=1
    if (( interactive )); then
      ask "Use it for the claude CLI too (CLAUDE_CONFIG_DIR)? [Y/n] " y
      [[ $REPLY == [nN]* ]] && cli=0
    fi
  fi
  (( desktop || cli )) || usage_error "a profile needs a desktop app (--desktop) or the CLI (--cli)"

  all_slugs
  palette_color=${DEFAULT_PALETTE[$(( ${#reply} % ${#DEFAULT_PALETTE} + 1 ))]}
  if [[ -z $color_kind ]] && (( desktop )); then
    if (( interactive )); then
      ask "Icon color as #rrggbb (empty = open the color picker): "
      if [[ -n $REPLY ]]; then
        color_kind=hex color_value=$REPLY
      else
        color_kind=pick
      fi
    else
      color_kind=hex color_value=$palette_color
    fi
  fi

  if (( interactive )) && [[ -z $data_dir || -z $config_dir ]]; then
    scan_collect
    if (( desktop )) && [[ -z $data_dir ]] && (( ${#SC_DATA} )); then
      pick_from_menu "Desktop data dir for \"$name\" (adopting one reuses its sign-in):" "${SC_DATA[@]}"
      (( REPLY == 0 )) || data_dir=$SC_DATA[REPLY]
    fi
    if [[ -z $config_dir ]] && (( ${#SC_CFG} )); then
      for (( i = 1; i <= ${#SC_CFG}; i++ )); do
        cfg_labels+=( "$(tilde "$SC_CFG[i]") ($SC_CFG_N[i] projects)" )
      done
      pick_from_menu "Claude Code config dir for \"$name\" (sessions, settings, CLI sign-in):" "${cfg_labels[@]}"
      (( REPLY == 0 )) || config_dir=$SC_CFG[REPLY]
    fi
  fi

  profile_reset
  SLUG=$slug
  PROFILE_NAME=$name
  PROFILE_DESKTOP=$desktop
  PROFILE_CLI=$cli
  PROFILE_MODE=${mode:-self}
  [[ -n $data_dir ]] && PROFILE_DATA_DIR=$(abs_path "$data_dir")
  [[ -n $config_dir ]] && PROFILE_CONFIG_DIR=$(abs_path "$config_dir")
  profile_fill_defaults

  if same_path "$PROFILE_DATA_DIR" "$MAIN_DATA_DIR"; then
    usage_error "--data-dir cannot be the main Claude data dir ($MAIN_DATA_DIR)"
  fi
  if (( desktop )); then
    assert_app_path "$PROFILE_APP"
    if [[ -e $PROFILE_APP ]]; then
      die "$PROFILE_APP already exists. To register an existing copy use: claude-profiles adopt"
    fi
    if [[ -n $PROFILE_LAUNCHER && -e $PROFILE_LAUNCHER ]]; then
      die "$PROFILE_LAUNCHER already exists. To register an existing copy use: claude-profiles adopt"
    fi
  fi
  for other_slug in $reply; do
    other_data=$(profile_field "$other_slug" PROFILE_DATA_DIR)
    other_cfg=$(profile_field "$other_slug" PROFILE_CONFIG_DIR)
    if (( desktop )) && [[ -n $other_data ]] && same_path "$other_data" "$PROFILE_DATA_DIR"; then
      die "Profile \"$other_slug\" already uses the data dir $PROFILE_DATA_DIR."
    fi
    if [[ -n $other_cfg ]] && same_path "$other_cfg" "$PROFILE_CONFIG_DIR"; then
      warn "Profile \"$other_slug\" also uses the config dir $PROFILE_CONFIG_DIR (shared history and CLI sign-in)."
    fi
  done

  if (( interactive )) && (( ${#links} == 0 )); then
    (( ${+SP_CWD} )) || scan_collect
    for (( i = 1; i <= ${#SP_CWD}; i++ )); do
      same_path "$SP_CFG[i]" "$PROFILE_CONFIG_DIR" && continue
      link_choices+=( "$SP_CWD[i]" )
      link_labels+=( "$(tilde "$SP_CWD[i]")  ($(tilde "$SP_CFG[i]"), $SP_N[i] sessions)" )
    done
    if (( ${#link_choices} )); then
      print -u2 -r -- "Projects with history in other config dirs:"
      for (( i = 1; i <= ${#link_labels}; i++ )); do
        print -u2 -r -- "  $i) $link_labels[i]"
      done
      ask "Numbers to link to \"$name\" (space-separated, empty = none): "
      for n in ${=REPLY}; do
        [[ $n == <-> ]] && (( n >= 1 && n <= ${#link_choices} )) || usage_error "invalid project number: $n"
        links+=( "$link_choices[n]" )
      done
      if (( ${#links} )) && [[ -z $link_mode ]]; then
        ask "Link mode: symlink (shared history) / move (reassign) / copy [symlink]: " symlink
        link_mode=$REPLY
      fi
    fi
  fi
  : ${link_mode:=symlink}
  [[ $link_mode == (symlink|move|copy) ]] || usage_error "--link-mode must be symlink, move or copy"

  if (( ${#links} )); then
    (( ${+SP_CWD} )) || scan_collect
    for l in $links; do
      cwd=$(abs_path "$l")
      idx=$(find_project_source "$cwd" "$PROFILE_CONFIG_DIR")
      (( idx > 0 )) || die "No session history found for $cwd in the scanned config dirs (see: claude-profiles scan)."
      link_src_cfg+=( "$SP_CFG[idx]" )
      link_src_dir+=( "$SP_DIR[idx]" )
      link_cwd+=( "$cwd" )
    done
  fi

  if (( desktop )); then
    apply_color_choice "$color_kind" "$color_value"
  elif [[ $color_kind == hex ]]; then
    PROFILE_COLOR=$(normalize_hex "$color_value")
  fi

  for d in $dirs $link_cwd; do
    d=$(abs_path "$d")
    (( ${PROFILE_DIRS[(Ie)$d]} )) || PROFILE_DIRS+=( "$d" )
  done

  profile_save
  regen_rules
  say "Created profile \"$SLUG\" ($PROFILE_NAME${PROFILE_COLOR:+, $PROFILE_COLOR})"

  if ! is_main_config "$PROFILE_CONFIG_DIR"; then
    mkdir -p -- "$PROFILE_CONFIG_DIR"
  fi

  if (( ${#link_cwd} )); then
    if claude_running; then
      warn "Claude is running; it may rewrite .claude.json and undo project-entry changes. Quit Claude sessions that use these projects if entries go missing."
      if (( interactive )) && ! confirm "Continue linking ${#link_cwd} project(s)?"; then
        say "Skipped linking. Profile created; re-link later by hand."
        link_cwd=()
      fi
    fi
    for (( i = 1; i <= ${#link_cwd}; i++ )); do
      link_project "$link_src_cfg[i]" "$link_src_dir[i]" "$link_cwd[i]" "$link_mode" "$PROFILE_CONFIG_DIR"
    done
  fi

  if (( desktop && ! no_build )); then
    need_lock
    BUILD_MODE=$PROFILE_MODE
    build_profile "$SLUG"
  elif (( desktop )); then
    say "Skipped the build. Run: claude-profiles build $SLUG"
  fi
  if (( cli )); then
    say "CLI: eval \"\$(claude-profiles shell-init zsh)\" in ~/.zshrc, then use claude-$SLUG or add dirs: claude-profiles dirs $SLUG add PATH"
  fi
  if (( PLAIN )); then
    local launcher_out=-
    if (( desktop )) && is_self_mode && [[ -d $PROFILE_APP ]]; then
      launcher_out=$PROFILE_APP
    elif (( desktop )) && [[ -n $PROFILE_LAUNCHER && -d $PROFILE_LAUNCHER ]]; then
      launcher_out=$PROFILE_LAUNCHER
    fi
    print -r -- "created"$'\t'"$SLUG"$'\t'"$launcher_out"
  fi
}

cmd_build() {
  local target="" all=0
  while (( $# )); do
    case $1 in
      --all) all=1; shift ;;
      --mode) need_value "$@"; BUILD_MODE=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "build <slug>|--all [--mode self|launcher]" ;;
      *) target=$1; shift ;;
    esac
  done
  valid_mode_choice "$BUILD_MODE" || usage_error "--mode must be self or launcher"
  setup_colors
  ensure_config
  if (( all )); then
    [[ -z $target ]] || usage_error "build <slug>|--all"
    need_lock
    local SLUG ${PROFILE_KEYS[@]} s failed=0 count=0
    local -a PROFILE_DIRS reply targets
    all_slugs
    for s in $reply; do
      profile_load "$s"
      (( PROFILE_DESKTOP )) && targets+=( "$s" )
    done
    for s in $targets; do
      count=$(( count + 1 ))
      say "${C_BOLD}== $s${C_RESET}"
      if ! CLAUDE_PROFILES_LOCKED=1 CLAUDE_PROFILES_AUTO=1 CLAUDE_PROFILES_APP_MODE=$BUILD_MODE zsh "$SELF" build "$s"; then
        failed=$(( failed + 1 ))
        warn "build of \"$s\" failed"
      fi
    done
    (( count )) || say "No desktop profiles."
    dock_restart
    (( failed == 0 )) || die "$failed build(s) failed."
    return 0
  fi
  [[ -n $target ]] || usage_error "build <slug>|--all"
  need_lock
  build_profile "$target"
}

cmd_launcher() {
  local target=""
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      -*) usage_error "launcher <slug>" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "launcher <slug>"
  setup_colors
  profile_load "$target"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app."
  if is_self_mode; then
    die "\"$SLUG\" runs in self mode: one app per profile, no launcher. To switch back: claude-profiles build $SLUG --mode launcher"
  fi
  [[ -d $PROFILE_APP ]] || die "$PROFILE_APP not found. Build it first: claude-profiles build $SLUG"
  need_lock
  choose_sign_id keep
  build_launcher "$(copy_icns_path "$PROFILE_APP")"
  say "Launcher rebuilt: $PROFILE_LAUNCHER (quit ${PROFILE_APP:t:r} and reopen it via the launcher to apply)"
}

cmd_recolor() {
  local target="" color_kind="" color_value=""
  while (( $# )); do
    case $1 in
      --color) need_value "$@"; color_kind=hex; color_value=$2; shift 2 ;;
      --hue) (( $# >= 2 )) || usage_error "--hue needs a value"; color_kind=hue; color_value=$2; shift 2 ;;
      --pick-color) color_kind=pick; shift ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "recolor <slug> [--color '#hex'|--hue DEG|--pick-color]" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "recolor <slug> [--color '#hex'|--hue DEG|--pick-color]"
  setup_colors
  profile_load "$target"
  if [[ -z $color_kind ]]; then
    can_prompt || usage_error "recolor needs --color, --hue or --pick-color"
    color_kind=pick
  fi
  local src dst_icns
  if (( PROFILE_DESKTOP )) && [[ -d $PROFILE_APP ]]; then
    src=$(source_icns) || die "No .icns icon found in $SOURCE_APP; it is needed to tint $PROFILE_APP."
    assert_ours "$PROFILE_APP" "$PROFILE_BUNDLE_ID"
    need_lock
    choose_sign_id keep
    dst_icns=$(copy_icns_path "$PROFILE_APP")
    [[ -n $dst_icns ]] || die "$PROFILE_APP has no CFBundleIconFile; rebuild it: claude-profiles build $SLUG"
  fi
  apply_color_choice "$color_kind" "$color_value"
  profile_save
  say "Color of \"$SLUG\" is now $PROFILE_COLOR"
  if (( ! PROFILE_DESKTOP )); then
    return 0
  fi
  if [[ ! -d $PROFILE_APP ]]; then
    say "$PROFILE_APP is not built yet; the color applies on: claude-profiles build $SLUG"
    return 0
  fi
  say "Tinting icon..."
  tint_icns "$src" "$TMP/recolor.icns" "$PROFILE_COLOR" || die "Tinting failed."
  cp -f -- "$TMP/recolor.icns" "$dst_icns"
  if [[ -n $(plist_get "$PROFILE_APP" CFBundleIconName) ]]; then
    plutil -remove CFBundleIconName "$PROFILE_APP/Contents/Info.plist"
  fi
  say "Re-signing the outer bundle..."
  xattr -c "$dst_icns" 2>/dev/null || true
  sign_bundle "$PROFILE_APP" >/dev/null 2>&1 || die "Could not re-sign $PROFILE_APP; run: claude-profiles build $SLUG"
  touch -- "$PROFILE_APP"
  "$LSREG" -f "$PROFILE_APP" >/dev/null 2>&1 || true
  is_self_mode || build_launcher "$dst_icns"
  dock_restart
  if is_running "$PROFILE_APP"; then
    say "Done. ${PROFILE_APP:t:r} is running: its Dock icon updates after you quit and reopen it."
  else
    say "Done."
  fi
}

cmd_set() {
  local slug="" key="" value="" have_value=0
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      --clear) value=""; have_value=1; shift ;;
      -*) usage_error "set <slug> sign-identity NAME|--clear" ;;
      *)
        if [[ -z $slug ]]; then slug=$1
        elif [[ -z $key ]]; then key=$1
        elif (( ! have_value )); then value=$1; have_value=1
        else usage_error "set <slug> sign-identity NAME|--clear"
        fi
        shift ;;
    esac
  done
  [[ -n $slug && -n $key ]] && (( have_value )) || usage_error "set <slug> sign-identity NAME|--clear"
  [[ $key == sign-identity ]] || usage_error "set: unknown setting \"$key\" (only sign-identity)"
  setup_colors
  reject_control_chars "set value" "$value"
  profile_load "$slug"
  if [[ -n $value ]]; then
    [[ $value != - ]] && valid_identity "$value" || usage_error "invalid identity \"$value\" (letters, digits, space, dot, underscore, dash)"
    identity_present "$value" || warn "Identity \"$value\" is not in the login keychain yet; it is ignored until it is."
  fi
  need_lock
  PROFILE_SIGN_IDENTITY=$value
  profile_save
  if [[ -n $value ]]; then
    say "Signing identity of \"$SLUG\" is now \"$value\". Apply it to the existing copy: claude-profiles resign $SLUG"
  else
    say "Signing identity of \"$SLUG\" is automatic again."
  fi
}

cmd_resign() {
  local target=""
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "resign <slug>" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "resign <slug>"
  setup_colors
  profile_load "$target"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app."
  [[ -d $PROFILE_APP ]] || die "$PROFILE_APP not found. Build it first: claude-profiles build $SLUG"
  assert_ours "$PROFILE_APP" "$PROFILE_BUNDLE_ID"
  need_lock
  choose_sign_id keep
  say "Re-signing the outer bundle of ${PROFILE_APP:t:r}..."
  sign_bundle "$PROFILE_APP" >/dev/null 2>&1 || die "Could not re-sign $PROFILE_APP; run: claude-profiles build $SLUG"
  if [[ -d $PROFILE_LAUNCHER ]]; then
    assert_ours "$PROFILE_LAUNCHER" "$(launcher_id)"
    say "Re-signing the launcher..."
    xattr -cr "$PROFILE_LAUNCHER"
    sign_launcher "$PROFILE_LAUNCHER" || die "Could not re-sign $PROFILE_LAUNCHER"
    touch -- "$PROFILE_LAUNCHER"
    "$LSREG" -f "$PROFILE_LAUNCHER" >/dev/null 2>&1 || true
  fi
  touch -- "$PROFILE_APP"
  "$LSREG" -f "$PROFILE_APP" >/dev/null 2>&1 || true
  codesign --verify --strict "$PROFILE_APP" >/dev/null 2>&1 || warn "codesign --verify reported problems for $PROFILE_APP."
  say "Done. Nested code was left untouched. Check it: claude-profiles check $SLUG"
}

cmd_check() {
  local target=""
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "check <slug>" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "check <slug>"
  setup_colors
  profile_load "$target"
  local DST=$PROFILE_APP NAME=${PROFILE_APP:t:r} CFG=$PROFILE_CONFIG_DIR DATA=$PROFILE_DATA_DIR
  say "${C_BOLD}$SLUG${C_RESET} ($PROFILE_NAME)"
  if is_main_config "$CFG"; then
    infol "config dir is the default ~/.claude (no CLAUDE_CONFIG_DIR override)"
  elif [[ -d $CFG ]]; then
    ok "config dir exists ($CFG)"
  else
    warnl "config dir $CFG does not exist yet (Claude creates it on first use)"
  fi
  if (( PROFILE_CLI )); then
    if (( ${#PROFILE_DIRS} )); then
      infol "CLI auto-selects this profile in: ${(j:, :)PROFILE_DIRS}"
    else
      infol "no CLI dirs; use claude-$SLUG or: claude-profiles dirs $SLUG add PATH"
    fi
  fi
  if (( ! PROFILE_DESKTOP )); then
    infol "CLI-only profile: no desktop checks"
    return 0
  fi
  [[ -d $DST ]] || die "$DST not found. Build it first: claude-profiles build $SLUG"
  if is_self_mode; then
    ok "self mode: one app per profile, no launcher ($DST)"
    if [[ -e $APPS_DIR/${DST:t} ]]; then
      warnl "a hidden copy from launcher mode is still at $APPS_DIR/${DST:t}; remove it so search shows one entry"
    fi
  else
    if same_path "$PROFILE_LAUNCHER" "$DST"; then
      fail "the launcher path is the copy itself ($PROFILE_LAUNCHER): rebuilding the launcher would delete the copy. Fix the profile paths with: claude-profiles migrate-layout $SLUG"
    elif [[ -d $PROFILE_LAUNCHER && ${(L)$(plist_get "$PROFILE_LAUNCHER" CFBundleIdentifier)} == ${(L)PROFILE_BUNDLE_ID} ]]; then
      fail "$PROFILE_LAUNCHER holds a copy of Claude (bundle id $PROFILE_BUNDLE_ID), not a launcher. Fix: claude-profiles build $SLUG"
    fi
    if [[ $(layout_of_profile) == legacy ]]; then
      warnl "old layout: Spotlight and Raycast list two entries ('$NAME' and the launcher). Fix: claude-profiles migrate-layout $SLUG"
    else
      ok "layout: the copy is hidden in ${DST:h}; '${PROFILE_LAUNCHER:t:r}' is the only entry in search"
    fi
    infol "launcher mode: the Dock shows the launcher and the running copy as two icons. One app per profile: claude-profiles migrate-layout $SLUG"
  fi
  case $(dock_profile_state) in
    copy_pinned) warnl "the app copy is pinned in the Dock: opening it while it is closed starts it on the MAIN profile. Fix: claude-profiles dock $SLUG fix" ;;
    old_launcher_pinned)
      if is_self_mode; then
        warnl "the Dock pins an old launcher or hidden copy of this profile. Fix: claude-profiles dock $SLUG fix"
      else
        warnl "the Dock still pins the old launcher, which no longer exists. Fix: claude-profiles dock $SLUG fix"
      fi ;;
  esac
  if [[ -n $(ls -A "$DATA" 2>/dev/null) ]]; then
    ok "data dir is populated ($DATA)"
  elif is_self_mode; then
    fail "$DATA is empty/missing: open '$NAME' once; if it stays empty, the boot entry did not apply."
  else
    fail "$DATA is empty/missing: launch the copy via its launcher first; if it stays empty, the app ignores --user-data-dir."
  fi
  local -a main_pids all_pids
  main_pids=( ${(f)"$(app_main_pids "$DST")"} )
  all_pids=( ${(f)"$(app_all_pids "$DST")"} )
  if (( ${#main_pids} == 0 )); then
    infol "copy is not running right now"
  else
    local pid=$main_pids[1] cmdline envline lspid pid_list=${(j:,:)all_pids} open_count open_files
    open_files=$(lsof -p "$pid_list" 2>/dev/null || true)
    cmdline=$(ps -ww -o command= -p "$pid" 2>/dev/null || true)
    if is_self_mode; then
      open_count=$(grep -cF "$DATA/" <<<"$open_files" || true)
      if [[ $open_count != 0 ]]; then
        ok "PID $pid uses $DATA ($open_count open files across ${#all_pids} processes; no --user-data-dir needed)"
      else
        fail "PID $pid has no open files in $DATA: the boot entry did not apply. Quit it and run: claude-profiles build $SLUG"
      fi
    elif [[ $cmdline == *"--user-data-dir=$DATA"* ]]; then
      ok "PID $pid runs with --user-data-dir=$DATA"
    else
      fail "PID $pid has no --user-data-dir: it is using the MAIN Claude profile. Quit it and use the launcher."
    fi
    envline=" $(ps -E -ww -o command= -p "$pid" 2>/dev/null || true) "
    if is_main_config "$CFG"; then
      if [[ $envline == *" CLAUDE_CONFIG_DIR="* ]]; then
        warnl "PID $pid has CLAUDE_CONFIG_DIR set although the profile uses ~/.claude"
      else
        ok "PID $pid uses the default ~/.claude config"
      fi
    elif [[ $envline == *" CLAUDE_CONFIG_DIR=$CFG "* ]]; then
      ok "PID $pid runs with CLAUDE_CONFIG_DIR=$CFG"
    elif is_self_mode; then
      fail "PID $pid has no CLAUDE_CONFIG_DIR=$CFG in its environment (LSEnvironment missing?): Code sessions may use ~/.claude. Rebuild: claude-profiles build $SLUG"
    else
      fail "PID $pid has no CLAUDE_CONFIG_DIR=$CFG: Code sessions use ~/.claude. Quit it and use the launcher."
    fi
    if ! is_main_config "$CFG"; then
      open_count=$(grep -cF "$MAIN_CONFIG_DIR/" <<<"$open_files" || true)
      if [[ $open_count == 0 ]]; then
        ok "no open files in ~/.claude (${#all_pids} processes)"
      else
        fail "$open_count open files in ~/.claude"
      fi
    fi
    open_count=$(grep -cF "$MAIN_DATA_DIR/" <<<"$open_files" || true)
    if [[ $open_count == 0 ]]; then
      ok "no open files in the main Claude data dir, Crashpad included (${#all_pids} processes)"
    else
      fail "$open_count open files in the main Claude data dir"
    fi
    if is_self_mode; then
      open_count=$(grep -cF "$MAIN_LOGS_DIR/" <<<"$open_files" || true)
      if [[ $open_count == 0 ]]; then
        ok "no open files in the main Claude logs dir (${#all_pids} processes)"
      else
        fail "$open_count open files in the main Claude logs dir $MAIN_LOGS_DIR"
      fi
    fi
    lspid=$(ls_pid "$PROFILE_BUNDLE_ID")
    if [[ $lspid == 0 ]]; then
      fail "Launch Services reports PID 0 for $PROFILE_BUNDLE_ID: window managers cannot see its windows"
    elif [[ $lspid == "$pid" ]]; then
      ok "Launch Services PID $lspid matches the main process"
    else
      warnl "Launch Services PID $lspid differs from main process $pid"
    fi
  fi
  if codesign --verify --strict "$DST" 2>/dev/null; then
    ok "signature valid"
  else
    warnl "signature check failed"
  fi
  local sig outer_authority nested_identity
  sig=$(codesign -dvv "$DST" 2>&1 || true)
  outer_authority=$(first_authority "$DST")
  nested_identity=$(app_signing_identity "$DST" || true)
  resolve_sign_identity
  if [[ $SIGN_ID != - ]]; then
    ok "signing identity \"$SIGN_ID\" is usable ($SIGN_SOURCE)"
  elif [[ -n $SIGN_BLOCKED ]]; then
    warnl "signing identity \"$SIGN_BLOCKED\" is in the keychain but a test signature failed: unlock the login keychain or run in Terminal: claude-profiles setup"
  elif [[ $SIGN_IDENTITY == - && -z $PROFILE_SIGN_IDENTITY ]]; then
    infol "SIGN_IDENTITY is ad-hoc (-): every rebuild re-prompts Keychain/TCC"
  else
    warnl "signing identity \"${PROFILE_SIGN_IDENTITY:-$SIGN_IDENTITY}\" not found: run in Terminal: claude-profiles setup"
  fi
  if [[ -z $outer_authority && -n $nested_identity ]] && grep -q 'Signature=adhoc' <<<"$sig"; then
    if [[ $SIGN_ID != - ]]; then
      fail "mixed signature: $NAME is signed ad-hoc but its nested code is signed by \"$nested_identity\". Fix: claude-profiles resign $SLUG"
    else
      fail "mixed signature: $NAME is signed ad-hoc but its nested code is signed by \"$nested_identity\", which is not usable. Unlock the login keychain then run: claude-profiles resign $SLUG (or: claude-profiles set $SLUG sign-identity NAME)"
    fi
  elif [[ $SIGN_ID != - && $outer_authority == "$SIGN_ID" ]]; then
    ok "$NAME is signed by \"$SIGN_ID\" (stable signature, no re-prompts on rebuild)"
  elif grep -q 'Signature=adhoc' <<<"$sig"; then
    warnl "$NAME is signed ad-hoc: re-prompts on rebuild"
  else
    warnl "$NAME is signed by \"${outer_authority:-unknown}\", not by the resolved identity \"$SIGN_ID\""
  fi
  if launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
    ok "LaunchAgent $AGENT_LABEL is loaded"
  else
    warnl "LaunchAgent $AGENT_LABEL is not loaded: run in Terminal: claude-profiles setup"
  fi
  if [[ -d $SOURCE_APP && $(app_version "$SOURCE_APP") == "$(app_version "$DST")" ]]; then
    ok "copy matches source version $(app_version "$SOURCE_APP")"
  else
    warnl "copy is $(app_version "$DST"), source is $([[ -d $SOURCE_APP ]] && app_version "$SOURCE_APP" || print missing): rebuild pending"
  fi
  if is_self_mode; then
    check_boot_entry
  elif [[ -d $PROFILE_LAUNCHER ]]; then
    ok "launcher present ($PROFILE_LAUNCHER)"
  else
    fail "launcher missing: claude-profiles launcher $SLUG"
  fi
  infol "kept entitlements on main binary:"
  codesign -d --entitlements - --xml "$DST/Contents/MacOS/$(plist_get "$DST" CFBundleExecutable)" 2>/dev/null | plutil -p - 2>/dev/null | sed 's/^/        /' || true
  local scheme handler
  scheme=$(url_scheme)
  handler=$(url_get "$scheme")
  if [[ ${(L)handler} == ${(L)PROFILE_BUNDLE_ID} ]]; then
    if is_self_mode; then
      fail "$scheme:// opens this copy. It never claims the scheme by itself in self mode, so a link window is open (claude-profiles link $SLUG) or something else set it. Revert: claude-profiles link main"
    else
      fail "$scheme:// opens this copy (bare launch -> MAIN desktop profile). Run: claude-profiles link main"
    fi
  elif [[ ${(L)handler} == ${(L)$(src_id)} ]]; then
    ok "$scheme:// opens $handler"
  else
    infol "$scheme:// opens: $handler"
  fi
  return 0
}

check_boot_entry() {
  asar_boot_state "$DST" || { fail "could not read the app.asar header of $NAME. Fix: claude-profiles build $SLUG"; return 0; }
  if (( ! BOOT_PRESENT )); then
    fail "app.asar has no $ASAR_BOOT_FILE entry: the copy starts on the MAIN profile. Fix: claude-profiles build $SLUG"
    return 0
  fi
  if (( BOOT_ENTRY_OK && BOOT_MAIN_OK )); then
    ok "boot entry $ASAR_BOOT_FILE is present, passes its integrity hash and is package.json main"
  else
    fail "boot entry $ASAR_BOOT_FILE fails its integrity hash or is not package.json main. Fix: claude-profiles build $SLUG"
  fi
  if (( BOOT_VERSION == ASAR_BOOT_VERSION )); then
    ok "boot entry version $BOOT_VERSION is current"
  else
    warnl "boot entry version $BOOT_VERSION, this tool writes version $ASAR_BOOT_VERSION. Fix: claude-profiles build $SLUG"
  fi
  if (( BOOT_HASH_OK )); then
    ok "ElectronAsarIntegrity in Info.plist equals the recomputed app.asar header hash"
  else
    fail "ElectronAsarIntegrity in Info.plist does not match the app.asar header: the copy will not start. Fix: claude-profiles build $SLUG"
  fi
  if [[ $BOOT_DATA == "$DATA" && $BOOT_CONFIG == "$(boot_config_dir)" ]]; then
    ok "boot entry selects data dir $DATA and config dir ${BOOT_CONFIG:-~/.claude (default)}"
  else
    fail "boot entry selects data dir ${BOOT_DATA:--} and config dir ${BOOT_CONFIG:-~/.claude}, the profile uses $DATA and $CFG. Fix: claude-profiles build $SLUG"
  fi
}

cmd_link() {
  local target=""
  while (( $# )); do
    case $1 in
      --yes|-y) YES=1; shift ;;
      -*) usage_error "link <slug>|main" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "link <slug>|main"
  setup_colors
  local scheme
  scheme=$(url_scheme)
  if [[ $target == main || $target == default ]]; then
    url_set "$scheme" "$(src_id)" || die "Could not change the $scheme:// handler."
    rm -f -- "$LINK_STAMP"
    say "$scheme:// links now open $(src_id)"
    return 0
  fi
  profile_load "$target"
  (( PROFILE_DESKTOP )) || die "Profile \"$SLUG\" has no desktop app."
  [[ -d $PROFILE_APP ]] || die "$PROFILE_APP not found. Build it first: claude-profiles build $SLUG"
  url_set "$scheme" "$PROFILE_BUNDLE_ID" || die "Could not change the $scheme:// handler."
  ensure_home
  mkdir -p -- "$STATE_DIR"
  print -r -- "$SLUG $EPOCHSECONDS" > "$LINK_STAMP"
  say "$scheme:// links now open ${PROFILE_APP:t:r} (the auto-rebuild agent reverts this after ~$(( LINK_TTL / 60 )) min; revert now: claude-profiles link main)"
}

paths_nested() {
  [[ $1 == "$2" || $1 == "$2"/* || $2 == "$1"/* ]]
}

safe_to_delete_dir() {
  [[ -n $1 ]] || return 1
  local candidate root
  for candidate in "${1:a}" "${1:A}"; do
    [[ $candidate == "$HOME"/* || $candidate == "${HOME:A}"/* ]] || return 1
    [[ ${candidate:t} == .claude* || ${candidate:t} == Claude-* ]] || return 1
    for root in "$MAIN_CONFIG_DIR" "$MAIN_DATA_DIR" "$SOURCE_APP"; do
      paths_nested "$candidate" "${root:a}" && return 1
      paths_nested "$candidate" "${root:A}" && return 1
    done
  done
  return 0
}

dir_used_by_other() {
  local key=$1 path=$2 s value
  local -a reply
  all_slugs
  for s in $reply; do
    [[ $s == "$SLUG" ]] && continue
    value=$(profile_field "$s" "$key" 2>/dev/null || true)
    if [[ -n $value ]] && same_path "$value" "$path"; then
      print -r -- "$s"
      return 0
    fi
  done
  return 1
}

cmd_remove() {
  local target="" delete_data=0 delete_config=0
  while (( $# )); do
    case $1 in
      --delete-data) delete_data=1; shift ;;
      --delete-config) delete_config=1; shift ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "remove <slug> [--delete-data] [--delete-config] [--yes]" ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || usage_error "remove <slug> [--delete-data] [--delete-config] [--yes]"
  setup_colors
  profile_load "$target"
  local other
  if (( delete_data && ! PROFILE_DESKTOP )); then
    warn "\"$SLUG\" is a CLI-only profile with no desktop data; --delete-data is ignored."
    delete_data=0
  fi
  if (( delete_config )); then
    is_main_config "$PROFILE_CONFIG_DIR" && die "Refusing to delete the default config dir ~/.claude."
    safe_to_delete_dir "$PROFILE_CONFIG_DIR" || die "Refusing to delete $PROFILE_CONFIG_DIR."
    if other=$(dir_used_by_other PROFILE_CONFIG_DIR "$PROFILE_CONFIG_DIR"); then
      die "Profile \"$other\" also uses $PROFILE_CONFIG_DIR; not deleting it."
    fi
  fi
  if (( delete_data )); then
    safe_to_delete_dir "$PROFILE_DATA_DIR" || die "Refusing to delete $PROFILE_DATA_DIR."
    if other=$(dir_used_by_other PROFILE_DATA_DIR "$PROFILE_DATA_DIR"); then
      die "Profile \"$other\" also uses $PROFILE_DATA_DIR; not deleting it."
    fi
  fi
  if (( PROFILE_DESKTOP )); then
    [[ ! -e $PROFILE_APP ]] || { assert_app_path "$PROFILE_APP"; assert_ours "$PROFILE_APP" "$PROFILE_BUNDLE_ID"; }
    if same_path "$PROFILE_LAUNCHER" "$PROFILE_APP"; then
      die "The launcher path of \"$SLUG\" is the copy itself ($PROFILE_LAUNCHER). Fix the profile entry before removing it."
    fi
    [[ ! -e $PROFILE_LAUNCHER ]] || { assert_app_path "$PROFILE_LAUNCHER"; assert_ours "$PROFILE_LAUNCHER" "$(launcher_id)"; }
  fi
  local summary="Remove profile \"$SLUG\" ($PROFILE_NAME)"
  if (( PROFILE_DESKTOP )) && is_self_mode; then
    summary+=", ${PROFILE_APP:t}"
  elif (( PROFILE_DESKTOP )); then
    summary+=", ${PROFILE_APP:t} and ${PROFILE_LAUNCHER:t}"
  fi
  (( delete_data )) && summary+=", DELETE data dir $PROFILE_DATA_DIR"
  (( delete_config )) && summary+=", DELETE config dir $PROFILE_CONFIG_DIR"
  confirm "$summary?" || { say "Cancelled."; return 0; }
  need_lock
  if (( PROFILE_DESKTOP )) && [[ -d $PROFILE_APP ]] && is_running "$PROFILE_APP"; then
    say "Quitting ${PROFILE_APP:t:r}..."
    quit_app "$PROFILE_BUNDLE_ID" "$PROFILE_APP" || die "${PROFILE_APP:t:r} did not quit within $QUIT_WAIT_SECONDS s. Quit it and re-run."
  fi
  if (( PROFILE_DESKTOP )); then
    local scheme handler
    scheme=$(url_scheme)
    handler=$(url_get "$scheme")
    if [[ ${(L)handler} == ${(L)PROFILE_BUNDLE_ID} ]]; then
      url_set "$scheme" "$(src_id)" || warn "Could not restore $scheme:// to $(src_id)."
    fi
  fi
  if (( PROFILE_DESKTOP )); then
    local app
    for app in "$PROFILE_LAUNCHER" "$PROFILE_APP"; do
      if [[ -e $app ]]; then
        "$LSREG" -u "$app" >/dev/null 2>&1 || true
        rm -rf -- "$app"
        say "Removed $app"
      fi
    done
    if same_path "${PROFILE_APP:h}" "$APPS_DIR"; then
      rmdir -- "$APPS_DIR" 2>/dev/null || true
    fi
    dock_profile_args
    dock_sync purge 0 0 0 || true
  fi
  if (( delete_data )) && [[ -e $PROFILE_DATA_DIR ]]; then
    rm -rf -- "$PROFILE_DATA_DIR"
    say "Deleted $PROFILE_DATA_DIR"
  fi
  if (( delete_config )) && [[ -e $PROFILE_CONFIG_DIR ]]; then
    rm -rf -- "$PROFILE_CONFIG_DIR"
    say "Deleted $PROFILE_CONFIG_DIR"
  fi
  rm -f -- "$PROFILES_DIR/$SLUG.env" "$STATE_DIR"/notified-$SLUG-*(N)
  if [[ -r $LINK_STAMP && $(<$LINK_STAMP) == "$SLUG "* ]]; then
    rm -f -- "$LINK_STAMP"
  fi
  local kept_slug=$SLUG kept_data=$PROFILE_DATA_DIR kept_cfg=$PROFILE_CONFIG_DIR kept_desktop=$PROFILE_DESKTOP
  regen_rules
  say "Removed profile \"$kept_slug\"."
  if (( kept_desktop && ! delete_data )) && [[ -e $kept_data ]]; then
    say "Kept data dir: $kept_data"
  fi
  (( delete_config )) || say "Kept config dir: $kept_cfg"
}

old_agents_for() {
  local app=$1 plist
  for plist in "$HOME"/Library/LaunchAgents/*.plist(N); do
    [[ ${plist:t:r} == "$AGENT_LABEL" ]] && continue
    if grep -qF -- "$app" "$plist" 2>/dev/null || grep -qF -- "<string>$SOURCE_APP</string>" "$plist" 2>/dev/null; then
      print -r -- "$plist"
    fi
  done
}

cmd_adopt() {
  local slug="" name="" app="" launcher="" data_dir="" config_dir="" identity="" color=""
  local -a dirs
  while (( $# )); do
    case $1 in
      --slug) need_value "$@"; slug=$2; shift 2 ;;
      --name) need_value "$@"; name=$2; shift 2 ;;
      --app) need_value "$@"; app=$2; shift 2 ;;
      --launcher) need_value "$@"; launcher=$2; shift 2 ;;
      --data-dir) need_value "$@"; data_dir=$2; shift 2 ;;
      --config-dir) need_value "$@"; config_dir=$2; shift 2 ;;
      --identity) need_value "$@"; identity=$2; shift 2 ;;
      --color) need_value "$@"; color=$2; shift 2 ;;
      --dir) need_value "$@"; dirs+=( "$2" ); shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      *) usage_error "adopt: unknown option $1" ;;
    esac
  done
  [[ -n $slug && -n $name && -n $app ]] || usage_error "adopt --slug s --name N --app PATH [--launcher PATH] [--data-dir P] [--config-dir P] [--identity NAME] [--color '#hex'] [--dir PATH]..."
  setup_colors
  reject_control_chars "adopt options" "$app" "$launcher" "$data_dir" "$config_dir" "$identity" "$color" "${dirs[@]}"
  valid_slug "$slug" || usage_error "invalid slug \"$slug\""
  valid_name "$name" || usage_error "invalid name \"$name\""
  valid_identity "${identity:--}" || usage_error "invalid identity \"$identity\" (letters, digits, space, dot, underscore, dash)"
  local flag dir_value
  for flag dir_value in --data-dir "$data_dir" --config-dir "$config_dir"; do
    [[ -n $dir_value ]] || continue
    dir_value=${dir_value/#\~/$HOME}
    [[ $dir_value == /* ]] || die "$flag must be an absolute path: $dir_value"
    [[ -d $dir_value ]] || die "$flag is not an existing directory: $dir_value"
  done
  ensure_config
  profile_exists "$slug" && die "Profile \"$slug\" already exists."
  app=$(abs_path "$app")
  assert_app_path "$app"
  [[ -d $app ]] || die "Not found: $app"
  local bundle_id
  bundle_id=$(plist_get "$app" CFBundleIdentifier)
  [[ -n $bundle_id ]] || die "$app has no CFBundleIdentifier."
  [[ ${(L)bundle_id} != ${(L)$(src_id)} ]] || die "$app has the same bundle id as $SOURCE_APP; it is not a separate copy."

  profile_reset
  SLUG=$slug
  PROFILE_NAME=$name
  PROFILE_DESKTOP=1
  PROFILE_CLI=1
  PROFILE_APP=$app
  PROFILE_BUNDLE_ID=$bundle_id
  if [[ -z $launcher ]] && asar_boot_state "$app" && (( BOOT_PRESENT )); then
    PROFILE_MODE=self
    [[ -n $data_dir || -z $BOOT_DATA ]] || data_dir=$BOOT_DATA
    [[ -n $config_dir ]] || config_dir=${BOOT_CONFIG:-$MAIN_CONFIG_DIR}
    say "${app:t} carries the self-mode boot entry: adopting it in self mode (no launcher)."
  elif [[ -n $launcher ]]; then
    PROFILE_LAUNCHER=$(abs_path "$launcher")
    same_path "$PROFILE_LAUNCHER" "$app" && die "--launcher must not be the copy itself ($app)."
  else
    local legacy_launcher="${app%.app} Launcher.app" hidden_launcher="$LAUNCHER_DIR/${app:t}"
    if [[ -d $legacy_launcher ]]; then
      PROFILE_LAUNCHER=$legacy_launcher
    elif ! same_path "$hidden_launcher" "$app" && [[ -d $hidden_launcher && ${(L)$(plist_get "$hidden_launcher" CFBundleIdentifier)} == ${(L)bundle_id}.launcher ]]; then
      PROFILE_LAUNCHER=$hidden_launcher
    fi
  fi
  [[ -n $data_dir ]] && PROFILE_DATA_DIR=$(abs_path "$data_dir")
  if [[ -n $config_dir ]]; then
    PROFILE_CONFIG_DIR=$(abs_path "$config_dir")
  else
    local env_cfg
    env_cfg=$(plist_get "$app" LSEnvironment:CLAUDE_CONFIG_DIR)
    [[ -n $env_cfg ]] && PROFILE_CONFIG_DIR=$env_cfg
  fi
  profile_fill_defaults
  same_path "$PROFILE_DATA_DIR" "$MAIN_DATA_DIR" && usage_error "--data-dir cannot be the main Claude data dir"
  if [[ -z $data_dir && ! -d $PROFILE_DATA_DIR ]]; then
    die "The default data dir $PROFILE_DATA_DIR does not exist. Pass --data-dir with the data dir this copy uses; otherwise \`auto\` would treat the copy as a bare launch and quit it."
  fi

  if [[ -n $color ]]; then
    resolve_color "$(normalize_hex "$color")"
  else
    local icns sampled
    icns=$(copy_icns_path "$app")
    if [[ -f $icns ]] && sampled=$(jxa color.js dominant-hex "$icns" 2>/dev/null); then
      resolve_color "$sampled"
    fi
  fi

  local d detected
  for d in $dirs; do
    d=$(abs_path "$d")
    (( ${PROFILE_DIRS[(Ie)$d]} )) || PROFILE_DIRS+=( "$d" )
  done
  if [[ -n $identity && $identity != - ]]; then
    PROFILE_SIGN_IDENTITY=$identity
    say "Signing identity: \"$identity\" (from --identity)"
  elif [[ -z $identity ]] && detected=$(app_signing_identity "$app"); then
    if valid_identity "$detected" && [[ $(probe_identity "$detected") == "$detected" ]]; then
      PROFILE_SIGN_IDENTITY=$detected
      say "Signing identity: \"$detected\" (detected from the copy's current signature)"
    else
      warn "$app is signed by \"$detected\", which is not usable here (missing from the login keychain, or the keychain is locked). Unlock it, then run: claude-profiles set $slug sign-identity \"$detected\""
    fi
  fi
  profile_save

  local kept_slug=$SLUG kept_app=$PROFILE_APP
  regen_rules
  say "Adopted $kept_app as profile \"$kept_slug\" (bundle id $bundle_id). Nothing was rebuilt."
  say "Check it: claude-profiles show $kept_slug && claude-profiles check $kept_slug"
  local -a old
  old=( ${(f)"$(old_agents_for "$kept_app")"} )
  if (( ${#old} )); then
    say ""
    say "These LaunchAgents also watch $SOURCE_APP (possibly an older rebuild setup for this copy). If so, remove them yourself:"
    local plist
    for plist in $old; do
      say "  launchctl bootout gui/$(id -u)/${plist:t:r}"
      say "  rm ${(q-)plist}"
    done
  fi
  say "Any old build script for this copy is no longer needed; delete it yourself when ready."
}

create_identity() {
  local dir="$TMP/identity" password
  mkdir -m 700 -- "$dir"
  password=$(/usr/bin/openssl rand -hex 16)
  cat > "$dir/openssl.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $SIGN_IDENTITY
[ext]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning
EOF
  /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 7300 -config "$dir/openssl.cnf" \
    -keyout "$dir/key.pem" -out "$dir/cert.pem" >/dev/null 2>&1 || die "openssl could not generate the certificate"
  P12_PASSWORD=$password /usr/bin/openssl pkcs12 -export -inkey "$dir/key.pem" -in "$dir/cert.pem" \
    -name "$SIGN_IDENTITY" -out "$dir/identity.p12" -passout env:P12_PASSWORD || die "openssl could not export the .p12"
  if ! security import "$dir/identity.p12" -k "$KEYCHAIN" -P "$password" -T /usr/bin/codesign; then
    rm -f -- "$dir/key.pem" "$dir/identity.p12"
    die "security import failed"
  fi
  rm -f -- "$dir/key.pem" "$dir/identity.p12"
  say "Created identity \"$SIGN_IDENTITY\" (valid 20 years) in the login keychain"
}

cert_has_cn() {
  local subject rdn
  subject=$(/usr/bin/openssl x509 -noout -subject -nameopt RFC2253 -in "$1" 2>/dev/null) || return 1
  subject=${subject#subject=}
  for rdn in ${(s:,:)subject}; do
    [[ ${rdn## ##} == "CN=$2" ]] && return 0
  done
  return 1
}

select_identity_cert() {
  local name=$1 out=$2 all="$TMP/identity-all.pem" part
  security find-certificate -a -c "$name" -p "$KEYCHAIN" > "$all" || return 1
  awk -v prefix="$TMP/identity-cert-" '/-----BEGIN CERTIFICATE-----/ { n++ } n { print > (prefix n ".pem") }' "$all"
  for part in "$TMP"/identity-cert-*.pem(N); do
    if cert_has_cn "$part" "$name"; then
      cp -- "$part" "$out"
      return 0
    fi
  done
  return 1
}

trust_identity() {
  local cert="$TMP/identity-trust.pem"
  select_identity_cert "$SIGN_IDENTITY" "$cert" || die "no certificate with the exact name \"$SIGN_IDENTITY\" found in the login keychain"
  if security verify-cert -c "$cert" -p codeSign >/dev/null 2>&1; then
    say "Certificate is already trusted for code signing"
    return 0
  fi
  say "macOS will now ask for your login password ONCE to trust the certificate for code signing."
  security add-trusted-cert -r trustRoot -p codeSign -k "$KEYCHAIN" "$cert" || die "could not trust the certificate"
}

allow_codesign_noninteractive() {
  if [[ $(probe_sign_id) == "$SIGN_IDENTITY" ]]; then
    say "Non-interactive test signature OK"
    return 0
  fi
  say "Test signature failed: codesign is not allowed to use the private key without a prompt."
  say "Granting it access now; macOS asks for your LOGIN KEYCHAIN password (this tool never sees it)."
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -l "$SIGN_IDENTITY" "$KEYCHAIN"
  if [[ $(probe_sign_id) != "$SIGN_IDENTITY" ]]; then
    die "codesign still cannot sign with \"$SIGN_IDENTITY\" non-interactively. Check Keychain Access: the certificate must be trusted for Code Signing and its private key must exist."
  fi
  say "Non-interactive test signature OK"
}

xml_escape() {
  local s=${1//&/&amp;}
  s=${s//</&lt;}
  s=${s//>/&gt;}
  print -r -- "$s"
}

assert_owner_only_writable() {
  local p=$1 stop=$2 uid
  local -A st
  uid=$(id -u)
  while [[ $p != "$stop" && $p != / ]]; do
    zstat -H st -- "$p" || die "Cannot stat $p."
    if (( st[uid] != uid )); then
      die "$p is not owned by you, but the LaunchAgent would run code from it. Install the CLI or the app in a location you own (for example ~/.local/bin or ~/Applications), then re-run setup."
    fi
    if (( st[mode] & 8#022 )); then
      die "$p is writable by group or others, but the LaunchAgent would run code from it. Fix it with: chmod go-w ${(q-)p}"
    fi
    p=${p:h}
  done
}

assert_agent_path_trusted() {
  if [[ $SELF == /Volumes/* || $SELF == *AppTranslocation* ]]; then
    die "claude-profiles runs from $SELF (a disk image or a translocated app). Move Claude Profiles.app to /Applications (or install the CLI) first, then run setup again."
  fi
  local p home=${HOME:A}
  for p in $SELF $LIB; do
    if [[ $p == "$home"/* ]]; then
      assert_owner_only_writable "$p" "$home"
    elif [[ $p == /Applications/* ]]; then
      assert_owner_only_writable "$p" /Applications
    else
      die "$p is outside your home folder and /Applications, but the LaunchAgent would run code from it. Install the CLI or the app in a location you own, then re-run setup."
    fi
  done
}

write_agent() {
  assert_agent_path_trusted
  ensure_home
  mkdir -p -- "${AGENT_PLIST:h}" "${LOG_FILE:h}" "$STATE_DIR"
  local env_home=""
  if [[ -n ${CLAUDE_PROFILES_HOME:-} ]]; then
    env_home="    <key>CLAUDE_PROFILES_HOME</key>
    <string>$(xml_escape "$CP_HOME")</string>"
  fi
  cat > "$AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "$AGENT_LABEL")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>$(xml_escape "$SELF")</string>
    <string>auto</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>$(xml_escape "$SOURCE_APP")</string>
    <string>$(xml_escape "$SOURCE_APP/Contents/Info.plist")</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
$env_home
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$LOG_FILE")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$LOG_FILE")</string>
</dict>
</plist>
EOF
  plutil -lint "$AGENT_PLIST" >/dev/null || die "generated plist is invalid: $AGENT_PLIST"
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  sleep 1
  launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" || die "launchctl bootstrap failed"
  say "LaunchAgent loaded: $AGENT_LABEL (log: $LOG_FILE)"
}

cmd_setup() {
  local identity=""
  while (( $# )); do
    case $1 in
      --identity) need_value "$@"; identity=$2; shift 2 ;;
      *) usage_error "setup [--identity NAME]" ;;
    esac
  done
  setup_colors
  [[ -t 0 && -t 1 ]] || die "setup is interactive: run it in your own Terminal."
  [[ -d $SOURCE_APP ]] || die "Not found: $SOURCE_APP"
  reject_control_chars "--identity" "$identity"
  valid_identity "${identity:--}" || usage_error "invalid identity \"$identity\" (letters, digits, space, dot, underscore, dash)"
  assert_agent_path_trusted
  ensure_config
  if [[ -n $identity ]]; then
    SIGN_IDENTITY=$identity
  elif [[ $SIGN_IDENTITY == - ]]; then
    SIGN_IDENTITY=$DEFAULT_IDENTITY
  fi
  save_config
  acquire_lock || die "Another claude-profiles run is in progress ($LOCK_DIR)."

  if security find-certificate -c "$SIGN_IDENTITY" "$KEYCHAIN" >/dev/null 2>&1; then
    say "Identity \"$SIGN_IDENTITY\" already exists"
  else
    create_identity
  fi
  trust_identity
  allow_codesign_noninteractive
  write_agent

  local SLUG ${PROFILE_KEYS[@]} s
  local -a PROFILE_DIRS reply targets reopen
  all_slugs
  for s in $reply; do
    profile_load "$s"
    (( PROFILE_DESKTOP )) && targets+=( "$s" )
  done
  if (( ${#targets} == 0 )); then
    say "No desktop profiles yet. Create one: claude-profiles new"
    return 0
  fi
  ask "Rebuild ${#targets} desktop profile(s) now with the stable identity? [Y/n] " y
  if [[ $REPLY == [nN]* ]]; then
    say "Skipped. Rebuild later: claude-profiles build --all"
    return 0
  fi
  local failed=0
  for s in $targets; do
    profile_load "$s"
    if is_running "$PROFILE_APP"; then
      ask "Quit ${PROFILE_APP:t:r} now to rebuild it? [y/N] " n
      if [[ $REPLY != [yY]* ]]; then
        say "Skipped $s."
        continue
      fi
      quit_app "$PROFILE_BUNDLE_ID" "$PROFILE_APP" || { warn "${PROFILE_APP:t:r} did not quit; skipped."; continue; }
      reopen+=( "$PROFILE_LAUNCHER" )
    fi
    say "${C_BOLD}== $s${C_RESET}"
    if ! CLAUDE_PROFILES_LOCKED=1 CLAUDE_PROFILES_AUTO=1 zsh "$SELF" build "$s"; then
      failed=$(( failed + 1 ))
    fi
  done
  killall Dock 2>/dev/null || true
  local l
  for l in $reopen; do
    open "$l" || true
  done
  say ""
  say "macOS will prompt ONE last time per copy: Keychain access to \"Claude Safe Storage\" (click Always Allow),"
  say "and possibly microphone / screen recording / accessibility for the copy."
  say "Future automatic rebuilds keep the same signature, so no more prompts."
  (( failed == 0 )) || die "$failed build(s) failed."
}

cmd_uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  rm -f -- "$AGENT_PLIST"
  say "Removed LaunchAgent $AGENT_LABEL"
}

auto_fix_bare_launch() {
  local exe pattern pid bare_pid="" name=${PROFILE_APP:t:r}
  is_self_mode && return 0
  exe=$(plist_get "$PROFILE_APP" CFBundleExecutable)
  pattern="^$(re_escape "$PROFILE_APP")/Contents/MacOS/$(re_escape "${exe:-Claude}")( |\$)"
  for pid in ${(f)"$(pgrep -f "$pattern" 2>/dev/null || true)"}; do
    [[ -n $pid ]] || continue
    if [[ $(ps -ww -o command= -p "$pid" 2>/dev/null || true) != *"--user-data-dir=$PROFILE_DATA_DIR"* ]]; then
      bare_pid=$pid
    fi
  done
  if [[ -z $bare_pid ]]; then
    return 0
  fi
  if [[ ! -d $PROFILE_LAUNCHER ]]; then
    log_line "$SLUG: $name (PID $bare_pid) runs without --user-data-dir but the launcher $PROFILE_LAUNCHER does not exist: skipping, not quitting it"
    return 0
  fi
  if (( DRY )); then
    log_line "$name (PID $bare_pid) runs without --user-data-dir (MAIN desktop profile): would quit it and reopen via the launcher"
    return 0
  fi
  log_line "$name (PID $bare_pid) runs without --user-data-dir (MAIN desktop profile): quitting and reopening via the launcher"
  notify "$name was opened on the wrong profile; reopening it correctly" "$name"
  if ! quit_app "$PROFILE_BUNDLE_ID" "$PROFILE_APP"; then
    log_line "$name did not quit within $QUIT_WAIT_SECONDS s: leaving it on the wrong profile"
    notify "$name is on the wrong profile and did not quit: quit it and reopen it via the launcher" "$name"
    return 0
  fi
  open "$PROFILE_LAUNCHER" || true
  log_line "reopened $name via the launcher"
}

auto_restore_links() {
  local scheme handler src s match="" stamp_slug="" stamp_at=0 age
  local SLUG ${PROFILE_KEYS[@]}
  local -a PROFILE_DIRS reply parts
  scheme=$(url_scheme)
  src=$(src_id)
  handler=$(url_get "$scheme")
  if [[ $handler == (none|unknown) || ${(L)handler} == ${(L)src} ]]; then
    return 0
  fi
  all_slugs
  for s in $reply; do
    profile_load "$s"
    if [[ ${(L)PROFILE_BUNDLE_ID} == ${(L)handler} ]]; then
      match=$s
    fi
  done
  [[ -n $match ]] || return 0
  if [[ -r $LINK_STAMP ]]; then
    parts=( $(<$LINK_STAMP) )
    stamp_slug=${parts[1]:-}
    stamp_at=${parts[2]:-0}
  fi
  [[ $stamp_at == <-> ]] || stamp_at=0
  age=$(( EPOCHSECONDS - stamp_at ))
  if [[ $stamp_slug == "$match" ]] && (( age <= LINK_TTL )); then
    return 0
  fi
  if (( DRY )); then
    log_line "$scheme:// opens profile \"$match\" and the link window expired: would restore it to $src"
    return 0
  fi
  if url_set "$scheme" "$src"; then
    rm -f -- "$LINK_STAMP"
    log_line "$scheme:// opened profile \"$match\" and the link window expired: restored to $src"
    notify "$scheme:// links restored to Claude"
  else
    log_line "$scheme:// opened profile \"$match\" and the link window expired, but restoring it FAILED"
  fi
}

auto_profile() {
  local reason source_version name=${PROFILE_APP:t:r} notified
  source_version=$(app_version "$SOURCE_APP")
  if ! reason=$(stale_reason); then
    log_line "$SLUG: up to date ($source_version)"
    return 0
  fi
  if is_self_mode && ! asar_validate "$SOURCE_APP"; then
    log_line "$SLUG: stale ($reason) but self mode is not possible with $source_version ($ASAR_REASON): keeping the current copy, not rebuilding"
    return 0
  fi
  if ! codesign --verify --strict "$SOURCE_APP" >/dev/null 2>&1; then
    log_line "$SLUG: stale ($reason) but $SOURCE_APP fails its signature check (update in progress?): retrying next interval"
    return 0
  fi
  if ! source_team_ok; then
    log_line "$SLUG: stale ($reason) but $SOURCE_APP is not signed by Team ID $SOURCE_TEAM_ID: refusing to copy it (see SOURCE_TEAM_ID in $CONFIG_FILE)"
    return 0
  fi
  if is_running "$PROFILE_APP"; then
    notified="$STATE_DIR/notified-$SLUG-${source_version//[^A-Za-z0-9.]/_}"
    if (( DRY )); then
      log_line "$SLUG: stale ($reason) and $name is running: would notify once for $source_version and wait until it is quit"
    elif [[ -e $notified ]]; then
      log_line "$SLUG: stale ($reason) and $name is running: already notified for $source_version, waiting"
    else
      log_line "$SLUG: stale ($reason) and $name is running: notifying, waiting until it is quit"
      notify "Claude $source_version is installed. $name will update after you quit it." "$name"
      touch -- "$notified"
    fi
    return 0
  fi
  resolve_sign_identity
  if [[ $SIGN_ID == - && -n $SIGN_BLOCKED ]]; then
    log_line "$SLUG: stale ($reason) but identity \"$SIGN_BLOCKED\" is unusable: skipping so the copy is not downgraded to ad-hoc (run setup)"
    return 0
  fi
  if (( DRY )); then
    log_line "$SLUG: stale ($reason) and $name is not running: would rebuild now"
    return 0
  fi
  log_line "$SLUG: rebuilding: $reason"
  local build_status=0
  CLAUDE_PROFILES_LOCKED=1 CLAUDE_PROFILES_AUTO=1 CLAUDE_PROFILES_KEEP_MODE=1 zsh "$SELF" build "$SLUG" 2>&1 | stamp_lines || build_status=$?
  if (( build_status != 0 )); then
    log_line "$SLUG: rebuild FAILED (exit $build_status)"
    return 1
  fi
  rm -f -- "$STATE_DIR"/notified-$SLUG-*(N)
  log_line "$SLUG: rebuild OK ($source_version)"
}

cmd_auto() {
  while (( $# )); do
    case $1 in
      --dry-run) DRY=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "auto [--dry-run]" ;;
    esac
  done
  if (( ! DRY )); then
    ensure_home
    mkdir -p -- "${LOG_FILE:h}" "$STATE_DIR"
    acquire_lock || { log_line "another run is in progress ($LOCK_DIR)"; return 0; }
  fi
  local SLUG ${PROFILE_KEYS[@]} s overall=0
  local -a PROFILE_DIRS reply targets
  all_slugs
  for s in $reply; do
    profile_load "$s"
    (( PROFILE_DESKTOP )) && targets+=( "$s" )
  done
  if (( ${#targets} == 0 )); then
    log_line "no desktop profiles"
    return 0
  fi
  for s in $targets; do
    profile_load "$s"
    auto_fix_bare_launch
  done
  if [[ ! -d $SOURCE_APP ]]; then
    log_line "source missing: $SOURCE_APP"
    return 0
  fi
  auto_restore_links
  for s in $targets; do
    profile_load "$s"
    auto_profile || overall=1
  done
  return $overall
}

shell_quote() {
  print -r -- "${(qq)1}"
}

shell_init_emit() {
  local shell_name=${1:-}
  [[ $shell_name == (zsh|bash) ]] || usage_error "shell-init zsh|bash"
  local SLUG ${PROFILE_KEYS[@]} s
  local -a PROFILE_DIRS reply
  local mode=$CLI_RULE_MODE
  [[ $mode == (auto|warn|off) ]] || mode=auto
  print -r -- "unalias claude 2>/dev/null || true"
  cat <<EOF
__claude_profiles_rules=$(shell_quote "$RULES_FILE")
__claude_profiles_mode=$mode
function claude {
  local __cp_mode="\${CLAUDE_PROFILES_MODE:-\$__claude_profiles_mode}"
  if [ -n "\${CLAUDE_CONFIG_DIR+x}" ] || [ "\$__cp_mode" = off ] || [ ! -r "\$__claude_profiles_rules" ]; then
    command claude "\$@"
    return
  fi
  local __cp_prefix __cp_slug __cp_cfg __cp_best_slug= __cp_best_cfg= __cp_best_len=0
  while IFS=\$'\t' read -r __cp_prefix __cp_slug __cp_cfg; do
    [ -n "\$__cp_prefix" ] || continue
    case "\$PWD/" in
      "\$__cp_prefix"/*)
        if [ "\${#__cp_prefix}" -gt "\$__cp_best_len" ]; then
          __cp_best_len=\${#__cp_prefix}
          __cp_best_slug=\$__cp_slug
          __cp_best_cfg=\$__cp_cfg
        fi
        ;;
    esac
  done < "\$__claude_profiles_rules"
  if [ -z "\$__cp_best_slug" ]; then
    command claude "\$@"
    return
  fi
  if [ "\$__cp_mode" = warn ]; then
    printf 'claude-profiles: %s belongs to profile "%s" (%s).\nContinue on the default profile? [y/N] ' "\$PWD" "\$__cp_best_slug" "\$__cp_best_cfg" >&2
    local __cp_answer=
    read -r __cp_answer </dev/tty || __cp_answer=
    case "\$__cp_answer" in
      [yY]*) command claude "\$@" ;;
      *) printf 'Use: claude-%s\n' "\$__cp_best_slug" >&2; return 1 ;;
    esac
    return
  fi
  if [ -t 2 ]; then
    printf '\033[2m→ profile %s\033[0m\n' "\$__cp_best_slug" >&2
  else
    printf '→ profile %s\n' "\$__cp_best_slug" >&2
  fi
  if [ "\$__cp_best_cfg" = "\$HOME/.claude" ]; then
    command claude "\$@"
  else
    CLAUDE_CONFIG_DIR="\$__cp_best_cfg" command claude "\$@"
  fi
}
function claude-default {
  ( unset CLAUDE_CONFIG_DIR; command claude "\$@" )
}
EOF
  local -a env_cases
  all_slugs
  for s in $reply; do
    profile_load "$s"
    (( PROFILE_CLI )) || continue
    if is_main_config "$PROFILE_CONFIG_DIR"; then
      print -r -- "function claude-$s {"
      print -r -- "  ( unset CLAUDE_CONFIG_DIR; command claude \"\$@\" )"
      print -r -- "}"
      env_cases+=( "    $s) unset CLAUDE_CONFIG_DIR ;;" )
    else
      print -r -- "function claude-$s {"
      print -r -- "  CLAUDE_CONFIG_DIR=$(shell_quote "$PROFILE_CONFIG_DIR") command claude \"\$@\""
      print -r -- "}"
      env_cases+=( "    $s) export CLAUDE_CONFIG_DIR=$(shell_quote "$PROFILE_CONFIG_DIR") ;;" )
    fi
  done
  print -r -- "function claude-profile-env {"
  print -r -- "  case \"\$1\" in"
  print -r -- "    default) unset CLAUDE_CONFIG_DIR ;;"
  local line
  for line in $env_cases; do
    print -r -- "$line"
  done
  print -r -- "    *) printf 'claude-profile-env: unknown profile %s\\n' \"\$1\" >&2; return 1 ;;"
  print -r -- "  esac"
  print -r -- "}"
}

cmd_dirs() {
  local target=${1:-} action=${2:-} path_arg=${3:-}
  [[ -n $target && -n $action ]] || usage_error "dirs <slug> add|rm PATH | dirs <slug> list"
  reject_control_chars "dirs arguments" "$target" "$action" "$path_arg"
  setup_colors
  profile_load "$target"
  case $action in
    list)
      local d
      for d in $PROFILE_DIRS; do
        print -r -- "$d"
      done
      return 0 ;;
    add|rm)
      [[ -n $path_arg ]] || usage_error "dirs <slug> $action PATH" ;;
    *) usage_error "dirs <slug> add|rm PATH | dirs <slug> list" ;;
  esac
  local p
  p=$(abs_path "$path_arg")
  if [[ $action == add ]]; then
    if (( ${PROFILE_DIRS[(Ie)$p]} )); then
      say "$p is already a dir of \"$SLUG\""
      return 0
    fi
    PROFILE_DIRS+=( "$p" )
  else
    (( ${PROFILE_DIRS[(Ie)$p]} )) || die "$p is not a dir of \"$SLUG\""
    PROFILE_DIRS=( ${PROFILE_DIRS:#$p} )
  fi
  profile_save
  local kept_slug=$SLUG
  regen_rules
  if [[ $action == add ]]; then
    say "Added $p to \"$kept_slug\""
  else
    say "Removed $p from \"$kept_slug\""
  fi
}

config_dir_running() {
  local cfg=$1 pid envline s
  local SLUG ${PROFILE_KEYS[@]}
  local -a PROFILE_DIRS reply
  for pid in ${(f)"$(pgrep -x claude 2>/dev/null || true)"}; do
    [[ -n $pid ]] || continue
    envline=" $(ps -E -ww -o command= -p "$pid" 2>/dev/null || true) "
    if is_main_config "$cfg"; then
      [[ $envline == *" CLAUDE_CONFIG_DIR="* ]] || return 0
    elif [[ $envline == *" CLAUDE_CONFIG_DIR=$cfg "* ]]; then
      return 0
    fi
  done
  if is_main_config "$cfg" && is_running "$SOURCE_APP"; then
    return 0
  fi
  all_slugs
  for s in $reply; do
    profile_load "$s"
    if (( PROFILE_DESKTOP )) && same_path "$PROFILE_CONFIG_DIR" "$cfg" && is_running "$PROFILE_APP"; then
      return 0
    fi
  done
  return 1
}

projects_list() {
  local i kind t=$'\t'
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "projects <slug> list [--plain]" ;;
    esac
  done
  setup_colors
  scan_collect
  local found=0
  for (( i = 1; i <= ${#SP_CFG}; i++ )); do
    same_path "$SP_CFG[i]" "$PROFILE_CONFIG_DIR" || continue
    found=1
    kind=dir
    [[ -L $SP_CFG[i]/projects/$SP_DIR[i] ]] && kind=symlink
    if (( PLAIN )); then
      print -r -- "project${t}$SP_CWD[i]${t}$SP_N[i]${t}$(iso_time $SP_MTIME[i])${t}$kind"
    else
      say "  $(tilde "$SP_CWD[i]")  ${C_DIM}$SP_N[i] sessions, last $(strftime '%Y-%m-%d %H:%M' $SP_MTIME[i]), $kind${C_RESET}"
    fi
  done
  if (( ! found && ! PLAIN )); then
    say "${C_DIM}No session history in $(tilde "$PROFILE_CONFIG_DIR")${C_RESET}"
  fi
}

projects_add() {
  local mode=symlink add_dir=1 cwd idx i
  local -a cwds plan_cwd plan_cfg plan_dir already
  while (( $# )); do
    case $1 in
      --mode) need_value "$@"; mode=$2; shift 2 ;;
      --no-dir) add_dir=0; shift ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      -*) usage_error "projects <slug> add [--mode symlink|move|copy] [--no-dir] [--yes] CWD..." ;;
      *) cwds+=( "$1" ); shift ;;
    esac
  done
  (( ${#cwds} )) || usage_error "projects <slug> add [--mode symlink|move|copy] [--no-dir] [--yes] CWD..."
  [[ $mode == (symlink|move|copy) ]] || usage_error "--mode must be symlink, move or copy"
  reject_control_chars "projects arguments" "${cwds[@]}"
  setup_colors
  scan_collect
  local -A seen_cwd
  for cwd in $cwds; do
    cwd=$(abs_path "$cwd")
    (( ! ${+seen_cwd[$cwd]} )) || continue
    seen_cwd[$cwd]=1
    local in_target=0
    for (( i = 1; i <= ${#SP_CWD}; i++ )); do
      if [[ $SP_CWD[i] == "$cwd" ]] && same_path "$SP_CFG[i]" "$PROFILE_CONFIG_DIR"; then
        in_target=1
      fi
    done
    if (( in_target )); then
      already+=( "$cwd" )
      continue
    fi
    idx=$(find_project_source "$cwd" "$PROFILE_CONFIG_DIR")
    (( idx > 0 )) || die "No session history found for $cwd in the scanned config dirs (see: claude-profiles scan)."
    plan_cwd+=( "$cwd" )
    plan_cfg+=( "$SP_CFG[idx]" )
    plan_dir+=( "$SP_DIR[idx]" )
  done

  local -A busy_checked
  local src_cfg
  if [[ $mode == move ]]; then
    for src_cfg in $plan_cfg; do
      (( ! ${+busy_checked[$src_cfg]} )) || continue
      busy_checked[$src_cfg]=1
      if config_dir_running "$src_cfg"; then
        if (( YES )); then
          warn "Claude is running with config dir $src_cfg; moving anyway (--yes). It may rewrite .claude.json and undo the change."
        else
          die "Claude is running with config dir $src_cfg. Quit it, or re-run with --yes to move anyway."
        fi
      fi
    done
  fi
  if (( ${#plan_cwd} )) && config_dir_running "$PROFILE_CONFIG_DIR"; then
    warn "Claude is running with config dir $PROFILE_CONFIG_DIR; it may rewrite .claude.json and undo project-entry changes."
  fi

  for cwd in $already; do
    say "$cwd already has history in $(tilde "$PROFILE_CONFIG_DIR"); nothing to $mode"
  done
  for (( i = 1; i <= ${#plan_cwd}; i++ )); do
    link_project "$plan_cfg[i]" "$plan_dir[i]" "$plan_cwd[i]" "$mode" "$PROFILE_CONFIG_DIR"
  done
  if (( add_dir )); then
    local d changed=0
    for d in $already $plan_cwd; do
      if (( ! ${PROFILE_DIRS[(Ie)$d]} )); then
        PROFILE_DIRS+=( "$d" )
        changed=1
        say "Added $d to the folders of \"$SLUG\""
      fi
    done
    if (( changed )); then
      profile_save
      regen_rules
    fi
  fi
  say "Done: ${#plan_cwd} project(s) $mode, ${#already} already present."
}

cmd_projects() {
  local target=${1:-} action=${2:-}
  [[ -n $target && -n $action ]] || usage_error "projects <slug> list [--plain] | projects <slug> add [--mode symlink|move|copy] [--no-dir] [--yes] CWD..."
  shift 2
  setup_colors
  profile_load "$target"
  case $action in
    list) projects_list "$@" ;;
    add) projects_add "$@" ;;
    *) usage_error "projects <slug> list [--plain] | projects <slug> add [--mode symlink|move|copy] [--no-dir] [--yes] CWD..." ;;
  esac
}

default_shell_name() {
  if [[ ${SHELL:t} == bash ]]; then
    print -r -- bash
  else
    print -r -- zsh
  fi
}

default_rc_file() {
  if [[ $1 == bash ]]; then
    print -r -- "$HOME/.bashrc"
  else
    print -r -- "$HOME/.zshrc"
  fi
}

stable_cli_path() {
  if [[ -e $DEFAULT_BIN_DIR/claude-profiles ]]; then
    print -r -- "$DEFAULT_BIN_DIR/claude-profiles"
  else
    print -r -- "$SELF"
  fi
}

rc_block_text() {
  local cli ref
  cli=$(stable_cli_path)
  if [[ $cli =~ '^[A-Za-z0-9_./+@:-]+$' ]]; then
    ref=$cli
  else
    ref=${(qq)cli}
  fi
  print -r -- "$RC_BEGIN"
  print -r -- "eval \"\$($ref shell-init $1)\""
  print -r -- "$RC_END"
}

rc_block_state() {
  local f=$1 b e bn en
  if [[ ! -f $f ]]; then
    print -r -- absent
    return 0
  fi
  b=$(grep -cxF -- "$RC_BEGIN" "$f" || true)
  e=$(grep -cxF -- "$RC_END" "$f" || true)
  if (( b == 0 && e == 0 )); then
    print -r -- absent
    return 0
  fi
  if (( b == 1 && e == 1 )); then
    bn=$(grep -nxF -- "$RC_BEGIN" "$f" | cut -d: -f1)
    en=$(grep -nxF -- "$RC_END" "$f" | cut -d: -f1)
    if (( bn < en )); then
      print -r -- present
      return 0
    fi
  fi
  print -r -- malformed
}

rc_rewrite() {
  local mode=$1 f=$2 block=$3 input=$2
  [[ -f $f ]] || input=/dev/null
  CP_BLOCK=$block awk -v mode="$mode" -v begin="$RC_BEGIN" -v end="$RC_END" '
    $0 == begin {
      if (mode == "uninstall" && n > 0 && out[n] == "") n--
      if (mode == "install") out[++n] = ENVIRON["CP_BLOCK"]
      skip = 1; found = 1; next
    }
    skip { if ($0 == end) skip = 0; next }
    { out[++n] = $0 }
    END {
      if (mode == "install" && !found) {
        if (n > 0) out[++n] = ""
        out[++n] = ENVIRON["CP_BLOCK"]
      }
      for (i = 1; i <= n; i++) print out[i]
    }
  ' "$input"
}

rc_write() {
  local rc=$1 new=$2
  mkdir -p -- "${rc:h}"
  if [[ -f $rc ]]; then
    local backup=$rc.claude-profiles.bak
    [[ ! -e $backup ]] || backup=$backup.$(date +%Y%m%d-%H%M%S)
    [[ ! -e $backup ]] || backup=$backup.$$
    cp -p -- "$rc" "$backup"
  fi
  cat -- "$new" > "$rc"
}

conflicts_in_file() {
  local f=$1 depth=$2 re=$3 line num text p
  local -a hits words
  [[ -f $f ]] || return 0
  (( ! ${+CF_SEEN[${f:A}]} )) || return 0
  CF_SEEN[${f:A}]=1
  hits=( ${(f)"$(awk -v begin="$RC_BEGIN" -v end="$RC_END" -v re="$re" '
    $0 == begin { skip = 1; next }
    skip { if ($0 == end) skip = 0; next }
    $0 ~ ("^[[:space:]]*(function[[:space:]]+" re "([[:space:]]*\\(\\))?([[:space:]]|\\{|$)|" re "[[:space:]]*\\(\\)|alias[[:space:]]+(-[a-zA-Z]+[[:space:]]+)*" re "=)") { print NR "\t" $0 }
  ' "$f" 2>/dev/null || true)"} )
  for line in $hits; do
    num=${line%%$'\t'*}
    text=${line#*$'\t'}
    text=${text//$'\t'/ }
    text=${text##[[:space:]]##}
    CF_FOUND+=( "$(tilde "$f"):$num: ${text[1,100]}" )
  done
  (( depth < 3 )) || return 0
  for line in ${(f)"$(grep -E '(^|[[:space:];&|])(source|\.)[[:space:]]+[^[:space:]]' "$f" 2>/dev/null || true)"}; do
    [[ $line =~ '(^|[[:space:];&|])(source|\.)[[:space:]]+(.*)$' ]] || continue
    words=( ${(z)match[3]} )
    p=${(Q)words[1]:-}
    p=${p/#\~/$HOME}
    p=${p//'${ZDOTDIR:-$HOME}'/$HOME}
    p=${p//'${HOME}'/$HOME}
    p=${p//'$HOME'/$HOME}
    [[ $p == /* && $p != *'$'* && $p != *'`'* ]] || continue
    conflicts_in_file "$p" $(( depth + 1 )) "$re"
  done
}

rc_conflicts() {
  local re s f
  local -a reply
  re=default
  all_slugs
  for s in $reply; do
    re+="|$s"
  done
  re="claude(-($re))?"
  typeset -gA CF_SEEN
  CF_SEEN=()
  typeset -ga CF_FOUND
  CF_FOUND=()
  for f in "$@"; do
    conflicts_in_file "$f" 0 "$re"
  done
}

shell_init_rc_files() {
  local shell_name=$1
  if [[ $shell_name == bash ]]; then
    print -r -- "$HOME/.bash_profile"
    print -r -- "$HOME/.bash_login"
    print -r -- "$HOME/.profile"
    print -r -- "$HOME/.bashrc"
  else
    print -r -- "$HOME/.zshenv"
    print -r -- "$HOME/.zprofile"
    print -r -- "$HOME/.zshrc"
    print -r -- "$HOME/.zlogin"
  fi
}

shell_init_manage() {
  local action=$1
  shift
  local shell_name="" rc="" t=$'\t'
  while (( $# )); do
    case $1 in
      zsh|bash) shell_name=$1; shift ;;
      --rc) need_value "$@"; rc=$2; shift 2 ;;
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "shell-init install|uninstall|status [zsh|bash] [--rc FILE] [--plain]" ;;
    esac
  done
  setup_colors
  reject_control_chars "--rc" "$rc"
  [[ -n $shell_name ]] || shell_name=$(default_shell_name)
  local explicit_rc=0
  [[ -n $rc ]] && explicit_rc=1
  [[ -n $rc ]] || rc=$(default_rc_file "$shell_name")
  rc=$(abs_path "$rc")
  local state
  state=$(rc_block_state "$rc")
  case $action in
    install)
      [[ $state != malformed ]] || die "$rc has an unbalanced claude-profiles marker block. Fix or delete the lines between \"$RC_BEGIN\" and \"$RC_END\" by hand."
      local new=$TMP/rc.new
      rc_rewrite install "$rc" "$(rc_block_text "$shell_name")" > "$new"
      if [[ -f $rc ]] && cmp -s "$new" "$rc"; then
        say "Shell integration is already installed in $rc"
        return 0
      fi
      rc_write "$rc" "$new"
      say "Installed the claude-profiles block in $rc"
      say "Open a new terminal, or run: source ${(q-)rc}" ;;
    uninstall)
      [[ $state != malformed ]] || die "$rc has an unbalanced claude-profiles marker block. Fix or delete the lines between \"$RC_BEGIN\" and \"$RC_END\" by hand."
      if [[ $state == absent ]]; then
        say "Shell integration is not installed in $rc"
        return 0
      fi
      local new=$TMP/rc.new
      rc_rewrite uninstall "$rc" "" > "$new"
      rc_write "$rc" "$new"
      say "Removed the claude-profiles block from $rc" ;;
    status)
      local installed=0 c
      [[ $state == present ]] && installed=1
      local -a files
      if (( explicit_rc )); then
        files=( "$rc" )
      else
        files=( ${(f)"$(shell_init_rc_files "$shell_name")"} )
      fi
      rc_conflicts "${files[@]}"
      if (( PLAIN )); then
        print -r -- "installed${t}$installed${t}$rc"
        for c in $CF_FOUND; do
          print -r -- "conflict${t}$c"
        done
      else
        if (( installed )); then
          say "Shell integration: installed in $(tilde "$rc")"
        else
          say "Shell integration: not installed ($(tilde "$rc"))"
        fi
        for c in $CF_FOUND; do
          say "  conflict: $c"
        done
      fi ;;
  esac
}

cmd_shell_init() {
  case ${1:-} in
    install|uninstall|status) shell_init_manage "$@" ;;
    *) shell_init_emit "$@" ;;
  esac
}

plist_array() {
  $PB -c "Print :$2" "$1" 2>/dev/null | awk 'NR == 1 || /^}$/ { next } { sub(/^ +/, ""); print }' || true
}

agent_loaded() {
  launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1
}

legacy_agents_collect() {
  LA_PLIST=() LA_LABEL=() LA_LOADED=() LA_PROGRAM=()
  local only_app=${1:-}
  local plist label program hay s needle matched
  local SLUG ${PROFILE_KEYS[@]}
  local -a PROFILE_DIRS reply needles
  needles=( "$SOURCE_APP" )
  if [[ -n $only_app ]]; then
    needles+=( "$only_app" )
  else
    all_slugs
    for s in $reply; do
      profile_load "$s"
      if (( PROFILE_DESKTOP )); then
        needles+=( "$PROFILE_APP" )
      fi
    done
  fi
  for plist in "$AGENTS_DIR"/*.plist(N); do
    label=$(plutil -extract Label raw -o - "$plist" 2>/dev/null || true)
    [[ -n $label ]] || label=${plist:t:r}
    [[ $label != "$AGENT_LABEL" && ${plist:t:r} != "$AGENT_LABEL" ]] || continue
    has_control_chars "$label$plist" && continue
    program=${(j: :)${(f)"$(plist_array "$plist" ProgramArguments)"}}
    hay="$program"$'\n'"$(plist_array "$plist" WatchPaths)"
    matched=0
    for needle in $needles; do
      if [[ $hay == *"$needle"* ]]; then
        matched=1
        break
      fi
    done
    (( matched )) || continue
    LA_PLIST+=( "$plist" )
    LA_LABEL+=( "$label" )
    LA_PROGRAM+=( "${program//$'\t'/ }" )
    if agent_loaded "$label"; then
      LA_LOADED+=( 1 )
    else
      LA_LOADED+=( 0 )
    fi
  done
}

cmd_legacy_agents() {
  local action=list label="" i loaded_text t=$'\t'
  if [[ ${1:-} == disable ]]; then
    action=disable
    shift
  fi
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      -*) usage_error "legacy-agents [--plain] | legacy-agents disable LABEL [--yes]" ;;
      *) [[ $action == disable && -z $label ]] || usage_error "legacy-agents [--plain] | legacy-agents disable LABEL [--yes]"; label=$1; shift ;;
    esac
  done
  setup_colors
  if [[ $action == disable ]]; then
    [[ -n $label ]] || usage_error "legacy-agents disable LABEL [--yes]"
  fi
  legacy_agents_collect
  if [[ $action == list ]]; then
    for (( i = 1; i <= ${#LA_LABEL}; i++ )); do
      if (( PLAIN )); then
        print -r -- "agent${t}$LA_LABEL[i]${t}$LA_PLIST[i]${t}$LA_LOADED[i]${t}$LA_PROGRAM[i]"
      else
        loaded_text="not loaded"
        [[ $LA_LOADED[i] == 1 ]] && loaded_text=loaded
        say "$LA_LABEL[i]  ${C_DIM}$loaded_text  $(tilde "$LA_PLIST[i]")  $LA_PROGRAM[i]${C_RESET}"
      fi
    done
    if (( ! PLAIN && ${#LA_LABEL} == 0 )); then
      say "${C_DIM}No other LaunchAgents watch $(tilde "$SOURCE_APP") or a profile copy.${C_RESET}"
    fi
    return 0
  fi
  local idx=0
  for (( i = 1; i <= ${#LA_LABEL}; i++ )); do
    [[ $LA_LABEL[i] == "$label" ]] && idx=$i
  done
  (( idx > 0 )) || die "\"$label\" is not a legacy agent listed by: claude-profiles legacy-agents"
  local plist=$LA_PLIST[idx]
  [[ ! -e $plist.disabled ]] || die "$plist.disabled already exists; not overwriting it."
  confirm "Unload LaunchAgent \"$label\" and rename $plist to ${plist:t}.disabled?" || { say "Cancelled."; return 0; }
  if [[ $LA_LOADED[idx] == 1 ]]; then
    say "Unloading $label..."
    launchctl bootout "gui/$(id -u)/$label" || die "launchctl bootout failed for $label; plist left in place."
  else
    say "$label is not loaded."
  fi
  mv -- "$plist" "$plist.disabled"
  say "Renamed $plist to $plist.disabled (re-enable by renaming it back and running launchctl bootstrap)."
}

cmd_status() {
  while (( $# )); do
    case $1 in
      --plain) PLAIN=1; shift ;;
      --yes|-y) YES=1; shift ;;
      *) usage_error "status [--plain]" ;;
    esac
  done
  setup_colors
  local t=$'\t' link=$DEFAULT_BIN_DIR/claude-profiles
  local cli_installed=0 present=0 usable=0 agent_loaded_flag=0 version=- team_ok=0 scheme handler
  [[ -x $link ]] && cli_installed=1
  if [[ $SIGN_IDENTITY != - ]] && identity_present; then
    present=1
    [[ $(probe_sign_id) == "$SIGN_IDENTITY" ]] && usable=1
  fi
  agent_loaded "$AGENT_LABEL" && agent_loaded_flag=1
  if [[ -d $SOURCE_APP ]]; then
    version=$(app_version "$SOURCE_APP")
    source_team_ok && team_ok=1
  fi
  scheme=$(url_scheme)
  handler=$(url_get "$scheme")
  if (( PLAIN )); then
    print -r -- "cli_installed${t}$cli_installed${t}$link"
    print -r -- "identity${t}$SIGN_IDENTITY${t}$present${t}$usable"
    print -r -- "agent${t}$AGENT_LABEL${t}$agent_loaded_flag"
    print -r -- "source${t}$SOURCE_APP${t}$version${t}$team_ok"
    print -r -- "handler${t}$scheme${t}$handler"
    print -r -- "home${t}$CP_HOME"
    return 0
  fi
  local cli_text="not installed (run: claude-profiles install-cli)" agent_text="not loaded" team_text=failed
  (( cli_installed )) && cli_text="installed at $(tilde "$link")"
  (( agent_loaded_flag )) && agent_text=loaded
  (( team_ok )) && team_text=ok
  say "${C_BOLD}Command-line tool${C_RESET}  $cli_text"
  say "${C_BOLD}Signing identity${C_RESET}  $SIGN_IDENTITY  present $present, usable $usable"
  say "${C_BOLD}Auto-rebuild agent${C_RESET}  $AGENT_LABEL  $agent_text"
  say "${C_BOLD}Source app${C_RESET}  $(tilde "$SOURCE_APP")  $version  signature check $team_text"
  say "${C_BOLD}$scheme:// handler${C_RESET}  $handler"
  say "${C_BOLD}Config home${C_RESET}  $(tilde "$CP_HOME")"
}

cmd_install_cli() {
  local from=$ROOT share_dir=$DEFAULT_SHARE_DIR bin_dir=$DEFAULT_BIN_DIR prefix=""
  local share_given=0 bin_given=0
  while (( $# )); do
    case $1 in
      --from) need_value "$@"; from=$2; shift 2 ;;
      --prefix) need_value "$@"; prefix=$2; shift 2 ;;
      --share-dir) need_value "$@"; share_dir=$2; share_given=1; shift 2 ;;
      --bin-dir) need_value "$@"; bin_dir=$2; bin_given=1; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --plain) PLAIN=1; shift ;;
      *) usage_error "install-cli [--from DIR] [--prefix DIR] [--share-dir DIR] [--bin-dir DIR]" ;;
    esac
  done
  setup_colors
  reject_control_chars "install-cli options" "$from" "$prefix" "$share_dir" "$bin_dir"
  if [[ -n $prefix ]]; then
    prefix=$(abs_path "$prefix")
    (( share_given )) || share_dir=$prefix/share/claude-profiles
    (( bin_given )) || bin_dir=$prefix/bin
  fi
  from=$(abs_path "$from")
  share_dir=$(abs_path "$share_dir")
  bin_dir=$(abs_path "$bin_dir")
  [[ -f $from/bin/claude-profiles && -d $from/lib ]] || die "$from does not contain bin/claude-profiles and lib/."
  local link=$bin_dir/claude-profiles
  if [[ -e $link && ! -L $link ]]; then
    die "$link exists and is not a symlink; not replacing it."
  fi
  if same_path "$from" "$share_dir"; then
    say "Already running from $share_dir; nothing to copy."
  else
    local stage=$share_dir.new old=$share_dir.old
    say "Installing the CLI into $(tilde "$share_dir")..."
    mkdir -p -- "${share_dir:h}"
    rm -rf -- "$stage" "$old"
    mkdir -p -- "$stage"
    ditto --noqtn "$from/bin" "$stage/bin"
    ditto --noqtn "$from/lib" "$stage/lib"
    if [[ -f $from/VERSION ]]; then
      ditto --noqtn "$from/VERSION" "$stage/VERSION"
    fi
    chmod -R go-w "$stage"
    say "Swapping into place..."
    if [[ -e $share_dir || -L $share_dir ]]; then
      mv -- "$share_dir" "$old"
    fi
    if ! mv -- "$stage" "$share_dir"; then
      [[ ! -e $old ]] || mv -- "$old" "$share_dir"
      die "Could not move the new copy into place; the previous one was kept."
    fi
    rm -rf -- "$old"
  fi
  mkdir -p -- "$bin_dir"
  ln -sfn -- "$share_dir/bin/claude-profiles" "$link"
  say "Linked $(tilde "$link") -> $(tilde "$share_dir/bin/claude-profiles")"
  if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
    say "Note: $(tilde "$bin_dir") is not on your PATH."
  fi
  local installed_version=unknown
  if [[ -r $share_dir/VERSION ]]; then
    installed_version=${$(<"$share_dir/VERSION")//[[:space:]]/}
  fi
  say "Installed claude-profiles $installed_version"
}

main() {
  local cmd=${1:-help}
  (( $# )) && shift
  case $cmd in
    help|--help|-h|version|--version|-v) ;;
    *) load_config ;;
  esac
  setup_colors
  case $cmd in
    new) cmd_new "$@" ;;
    list|ls) cmd_list "$@" ;;
    scan) cmd_scan "$@" ;;
    show) cmd_show "$@" ;;
    build) cmd_build "$@" ;;
    launcher) cmd_launcher "$@" ;;
    migrate-layout) cmd_migrate_layout "$@" ;;
    dock) cmd_dock "$@" ;;
    resign) cmd_resign "$@" ;;
    set) cmd_set "$@" ;;
    recolor) cmd_recolor "$@" ;;
    check) cmd_check "$@" ;;
    link) cmd_link "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    adopt) cmd_adopt "$@" ;;
    setup) cmd_setup "$@" ;;
    auto) cmd_auto "$@" ;;
    uninstall-agent) cmd_uninstall_agent ;;
    shell-init) cmd_shell_init "$@" ;;
    dirs) cmd_dirs "$@" ;;
    projects) cmd_projects "$@" ;;
    legacy-agents) cmd_legacy_agents "$@" ;;
    status) cmd_status "$@" ;;
    install-cli) cmd_install_cli "$@" ;;
    version|--version|-v) print -r -- "claude-profiles $CP_VERSION" ;;
    help|--help|-h) usage ;;
    *) print -u2 -r -- "Unknown command: $cmd"; usage >&2; exit 2 ;;
  esac
}

main "$@"
